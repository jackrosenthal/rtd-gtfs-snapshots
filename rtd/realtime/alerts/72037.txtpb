}
description_text {
  translation {
    text: "In addition to regular service, the following times are the final trains departing from Denver Union Station:\r\n\r\n    A Line: 1:00 a.m.\r\n    B Line: 1:09 a.m.\r\n    D Line: 12:48 a.m.\r\n    E Line: 12:55 a.m.\r\n    G Line: 1:01 a.m.\r\n    N Line: 1:26 a.m.\r\n    W Line: 12:56 a.m.\r\n\r\nAll RTD bus and rail routes – as well as Access-a-Ride and FlexRide services – will be provided at no cost to customers from 7 p.m., Dec. 31, through 7 a.m. Thursday, Jan. 1."
    language: "en"
  }
}
