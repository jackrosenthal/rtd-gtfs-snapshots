cause: TECHNICAL_PROBLEM
effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 12:42 pm from Denver Airport Station and 17 other trips cancelled today due to work being performed at crossing. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n12:42 pm from Denver Airport Station\r\n1:12 pm from Denver Airport Station\r\n1:42 pm from Denver Airport Station\r\n2:12 pm from Denver Airport Station\r\n2:42 pm from Denver Airport Station\r\n3:12 pm from Denver Airport Station\r\n3:42 pm from Denver Airport Station\r\n4:12 pm from Denver Airport Station\r\n4:42 pm from Denver Airport Station\r\n\nAffected eastbound trips:\r\n12:45 pm from Union Station Track 1\r\n1:15 pm from Union Station Track 1\r\n1:45 pm from Union Station Track 1\r\n2:15 pm from Union Station Track 1\r\n2:45 pm from Union Station Track 1\r\n3:15 pm from Union Station Track 1\r\n3:45 pm from Union Station Track 1\r\n4:15 pm from Union Station Track 1\r\n4:45 pm from Union Station Track 1"
    language: "en"
  }
}
