header_text {
  translation {
    text: "A Line Trip 12:27 pm from Denver Airport Station and 21 other trips cancelled today due to work being performed at crossing. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n12:27 pm from Denver Airport Station\r\n12:42 pm from Denver Airport Station\r\n1:27 pm from Denver Airport Station\r\n1:42 pm from Denver Airport Station\r\n2:27 pm from Denver Airport Station\r\n2:42 pm from Denver Airport Station\r\n3:27 pm from Denver Airport Station\r\n4:27 pm from Denver Airport Station\r\n\nAffected eastbound trips:\r\n12:30 pm from Union Station Track 1\r\n1:00 pm from Union Station Track 1\r\n1:15 pm from Union Station Track 1\r\n1:30 pm from Union Station Track 1\r\n2:00 pm from Union Station Track 1\r\n2:15 pm from Union Station Track 1\r\n2:30 pm from Union Station Track 1\r\n3:00 pm from Union Station Track 1\r\n3:15 pm from Union Station Track 1\r\n3:30 pm from Union Station Track 1\r\n4:00 pm from Union Station Track 1\r\n4:15 pm from Union Station Track 1\r\n4:30 pm from Union Station Track 1\r\n5:00 pm from Union Station Track 1"
    language: "en"
  }
}
