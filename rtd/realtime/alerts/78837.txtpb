header_text {
  translation {
    text: "Route 7 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nDiscontinue the 10:30 p.m. and 11:30 p.m. trips in both directions on weekdays. This will shift late-evening service after 10:00 p.m. from every 30 minutes to every 60 minutes.\r\n\nReason\r\nManages resources more efficiently, accounting for continued low ridership of the discontinued trips.\r\n\nSurvey Results\r\nOut of 13 respondents, 8% reported a positive impact from the change, 69% indicated it had no impact, and 23% perceived the change negatively."
    language: "en"
  }
}
