header_text {
  translation {
    text: "Route 53 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute 53 will be reinstated, operating seven days a week between US36 & Sheridan Station and Broomfield Municipal Center, with hourly service weekdays, Saturdays, and Sundays/Holidays from 6:00 a.m. to 9:00 p.m. Service will begin on a temporary detour due to construction.\r\n\nReason\r\nRestores service per RTD\'s System Optimization Plan while maintaining connections along the route during construction.\r\n\nSurvey Results\r\nOut of 28 respondents, 82% reported a positive impact from the change, 18% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
