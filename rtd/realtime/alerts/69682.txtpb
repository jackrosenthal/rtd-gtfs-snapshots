header_text {
  translation {
    text: "Civic Center Station closed due to fire department activity."
    language: "en"
  }
}
description_text {
  translation {
    text: "Buses will be boarding at Broadway & 14th and on Lincoln & 17th until fire department is clear. \r\n\nAffected stops:\r\nCivic Center Loop (#23485) (union stn)\r\nCivic Center Loop (#26118) (civic ctr)\r\nCivic Center Station (16th Drop-Off) (#35030) (eastbound)\r\nCivic Center Station (16th Drop-Off) (#35030) (northbound)\r\nCivic Center Station (16th Drop-Off) (#35030) (southbound)\r\nCivic Center Station (16th Drop-Off) (#35030) (westbound)\r\nCivic Center Station Gate 2 (#35032) (westbound)\r\nCivic Center Station Gate 3 (#35033) (eastbound)\r\nCivic Center Station Gate 3 (#35033) (northbound)\r\nCivic Center Station Gate 3 (#35033) (westbound)\r\nCivic Center Station Gate 4 (#35034) (northbound)\r\nCivic Center Station Gate 4 (#35034) (southbound)\r\nCivic Center Station Gate 5 (#35035) (eastbound)\r\nCivic Center Station Gate 5 (#35035) (westbound)\r\nCivic Center Station Gate 6 (#35036) (northbound)\r\nCivic Center Station Gate 6 (#35036) (southbound)\r\nCivic Center Station Gate 6 (#35036) (westbound)\r\nCivic Center Station Gate 7 (#35037) (eastbound)\r\nCivic Center Station Gate 7 (#35037) (westbound)\r\nCivic Center Station Gate 8 (#35038) (eastbound)\r\nCivic Center Station Gate 8 (#35038) (westbound)\r\nCivic Center Station Gate 9 (#35039) (northbound)\r\nCivic Center Station Gate 9 (#35039) (southbound)"
    language: "en"
  }
}
