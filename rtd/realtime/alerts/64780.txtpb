cause: MAINTENANCE
effect: DETOUR
header_text {
  translation {
    text: "Shuttle buses replacing A Line westbound Trip 12:27 am from Denver Airport Station to Union Station Track 1 and 2 other trips due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n12:27 am from Denver Airport Station to Union Station Track 1\r\n12:57 am from Denver Airport Station to Union Station Track 1\r\n1:27 am from Denver Airport Station to Union Station Track 1\r\n\nAffected stops:\r\nDenver Airport Station (#34476)\r\n61st & Pena Station Track 2 (#34606)\r\n40th Ave & Airport Blvd - Gateway Park Station Track 2 (#34474)\r\nPeoria Station Track 2 (#34472)\r\nCentral Park Station Track 2 (#34470)"
    language: "en"
  }
}
