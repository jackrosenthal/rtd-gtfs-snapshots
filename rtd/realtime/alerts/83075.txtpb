header_text {
  translation {
    text: "Board A Line Trip 10:00 pm from Denver Union Station and 5 other trips on track 2 today due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected direction: Eastbound\r\n\nAffected eastbound trips:\r\n10:00 pm from Union Station Track 1\r\n10:30 pm from Union Station Track 1\r\n11:00 pm from Union Station Track 1\r\n11:30 pm from Union Station Track 1\r\n12:00 am from Union Station Track 1\r\n12:30 am from Union Station Track 1\r\n\nAffected stops:\r\n38th & Blake Station Track 1 (#34465)\r\n40th & Colorado Station Track 1 (#34467)\r\nCentral Park Station Track 1 (#34469)"
    language: "en"
  }
}
severity_level: WARNING
