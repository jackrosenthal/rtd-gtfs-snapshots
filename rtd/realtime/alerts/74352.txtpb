header_text {
  translation {
    text: "R Line Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "It is proposed to extend service to RidgeGate Parkway, while providing 15-minute service frequency on weekdays from 6:00 a.m.–6:00 p.m., and Saturdays and Sundays/Holidays from 9:00a.m.–6:00 p.m.\r\n\nReason: Provide additional service to better match demand while accounting for suspension of H Line service.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs "
    language: "en"
  }
}
