header_text {
  translation {
    text: "Route 225T notice: beginning Mon Jan 26."
    language: "en"
  }
}
description_text {
  translation {
    text: "Buses will hold at Lafayette Park-n-Ride eastbound for an extended period, delays up to 10 minutes may be experienced. Westbound return trips will not have extended wait times. \r\n\nAffected stops:\r\nSouth Boulder Rd & Saratoga Dr (#22308) (eastbound)\r\nSouth Boulder Rd & Robin Hood St (#22301) (eastbound)\r\nSouth Boulder Rd & Round Table Dr (#35499) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (westbound)\r\nCanterbury Dr & Emma St (#35566) (westbound)\r\nEmma St & 120th St (#35504) (westbound)\r\nS 120th St & Canterbury Dr (#35496) (westbound)\r\nSouth Boulder Rd & Round Table Dr (#35498) (westbound)\r\nSouth Boulder Rd & Robin Hood St (#22302) (westbound)\r\nSouth Boulder Rd & Malory St (#22307) (westbound)"
    language: "en"
  }
}
