  translation {
    text: "Change\r\nThe 5:52 p.m. weekday, eastbound trip from Bent/Dry Creek will be adjusted to depart at 6 p.m.\r\n\nReason\r\nAllows for improved connections at 8th Avenue and Coffman Street.\r\n\nSurvey Results\r\nOut of 10 respondents, 40% reported a positive impact from the change, 60% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
