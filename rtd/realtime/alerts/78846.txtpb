  route_type: 3
}
cause: UNKNOWN_CAUSE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "Route 17 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nMinor changes to weekday, Saturday and Sunday/Holiday schedules, and adaptation of the eastbound routing near Oak Station to streamline the path and eliminate inefficient left turns. The new pattern will operate from stop 12979, West Colfax and Simms Street, turning right on Oak Street and right on West Rail Road to serve Oak Station, turning left on Quail Street, and continuing to Federal Center Station.\r\n\nReason\r\nImproves on-time performance, service reliability, and transfers with Route 16 by strengthening connections at Oak Station, creating a more efficient and consistent route alignment.\r\n\nSurvey Results\r\nOut of 8 respondents, 50% reported a positive impact from the change, 50% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
