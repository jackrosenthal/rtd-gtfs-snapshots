header_text {
  translation {
    text: "Route 72 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute 72 will be extended to serve the Clear Creek Crossing Transit Center in Wheat Ridge via 58th Ave. Five weekday trips will be added (two eastbound and three westbound) to provide earlier morning service and improve connections to Lutheran Hospital.\r\n\nReason\r\nProvides additional service and improved connections to Lutheran Hospital earlier in the morning and facilitates transfers to the G Line, and Routes 38 and 32.\r\n\nSurvey Results\r\nOut of 16 respondents, 88% reported a positive impact from the change, 6% indicated it had no impact, and 6% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
