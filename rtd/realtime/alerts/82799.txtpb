  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n4:00 pm from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n5:12 pm from Peoria Station\r\n\nAffected stops:\r\nPeoria Station\r\nFitzsimons Station\r\nColfax Station\r\n13th Ave Station\r\n2nd Ave & Abilene Station\r\nAurora Metro Center Station\r\n\n"
    language: "en"
  }
}
