cause: MAINTENANCE
effect: OTHER_EFFECT
header_text {
  translation {
    text: "A Line Trip 8:00 pm from Union Station Track 1 and 9 other trips experiencing up to 15 minute delays today due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n8:00 pm from Union Station Track 1\r\n8:30 pm from Union Station Track 1\r\n9:00 pm from Union Station Track 1\r\n9:30 pm from Union Station Track 1\r\n10:00 pm from Union Station Track 1\r\n10:30 pm from Union Station Track 1\r\n11:00 pm from Union Station Track 1\r\n11:30 pm from Union Station Track 1\r\n12:00 am from Union Station Track 1\r\n12:30 am from Union Station Track 1\r\n\nAffected stops:\r\n61st / Pena Station\r\nDenver Airport Station"
    language: "en"
  }
}
