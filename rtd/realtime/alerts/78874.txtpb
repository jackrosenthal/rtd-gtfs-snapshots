header_text {
  translation {
    text: "Route 120 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nThe following low-ridership, late-evening weekday trips will be discontinued: westbound 10:00 p.m. and 11:00 p.m. (average 4 and 5 boardings per trip) eastbound 10:02 p.m. (average 7 boardings per trip)\r\n\nReason\r\nVery low utilization makes these trips inefficient.\r\n\nSurvey Results\r\nOut of 23 respondents, 18% reported a positive impact from the change, 39% indicated it had no impact, and 52% perceived the change negatively."
    language: "en"
  }
}
