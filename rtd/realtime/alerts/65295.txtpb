  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n10:12 am from Florida Station to 18th & California Station\r\n12:12 pm from Florida Station to 18th & California Station\r\n2:12 pm from Florida Station to 18th & California Station\r\n4:12 pm from Florida Station to 18th & California Station\r\n6:12 pm from Florida Station to 18th & California Station\r\n\nAffected southbound trips:\r\n11:00 am from 18th & Stout Station to Florida Station\r\n1:00 pm from 18th & Stout Station to Florida Station\r\n3:00 pm from 18th & Stout Station to Florida Station\r\n5:00 pm from 18th & Stout Station to Florida Station"
    language: "en"
  }
}
