effect: NO_SERVICE
header_text {
  translation {
    text: "Update: S Line Trip 2:19 pm from I-25 & Broadway Station and 11 other trips cancelled today due to mechanical issue. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n2:19 pm from I-25 & Broadway Station\r\n3:49 pm from I-25 & Broadway Station\r\n5:19 pm from I-25 & Broadway Station\r\n6:49 pm from I-25 & Broadway Station\r\n8:19 pm from I-25 & Broadway Station\r\n9:49 pm from I-25 & Broadway Station\r\n\nAffected southbound trips:\r\n3:01 pm from 30th & Downing Station\r\n4:31 pm from 30th & Downing Station\r\n6:01 pm from 30th & Downing Station\r\n7:31 pm from 30th & Downing Station\r\n9:01 pm from 30th & Downing Station\r\n10:31 pm from 30th & Downing Station"
    language: "en"
  }
}
