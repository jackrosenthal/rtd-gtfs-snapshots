    text: "https://www.rtd-denver.com/community/news/2026/rtd-offers-temporary-alternative-parking-during-a-planned-five-day-paving-project-at-nederland-park-n-ride"
    language: "en"
  }
}
header_text {
  translation {
    text: "Change at Nederland PnR (#21899) (eastbound) and Nederland PnR (#21899) (westbound) from Mon Sep 28 through Thu Oct 1."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD will close portions of the Nederland Park-n-Ride beginning Monday, Sept. 28 as crews repair cracked and damaged asphalt and repave the parking areas. \r\n\nCrews will close one lot at a time and customers will be directed to available parking while paving operations take place.The work is not expected to impact bus and pedestrian access or transit service. \r\n\nWork on both portions of the lot is expected to be completed and reopened Friday, Oct. 2.\r\n\nA map and additional details are available in the link below.\r\n\nAffected routes:\r\nNB1\r\nNB2"
    language: "en"
  }
}
severity_level: WARNING
