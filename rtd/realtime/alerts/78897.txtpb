header_text {
  translation {
    text: "R Line service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nExtension of service to RidgeGate Parkway, while providing 15-minute service frequency on weekdays from 6:00 a.m.–6:00 p.m., and Saturdays and Sundays/Holidays from 9:00a.m.–6:00 p.m.\r\n\nReason\r\nProvide additional service to better match demand while accounting for suspension of H Line service.\r\n\nSurvey Results\r\nOut of 59 respondents, 85% reported a positive impact from the change, 12% indicated it had no impact, and 3% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject\r\n"
    language: "en"
  }
}
