header_text {
  translation {
    text: "Route 37 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "It is proposed to adjust Route 37 to operate every 30 minutes during weekday peak periods, and hourly during midday and evening.\r\n\nReason: Support RTD\'s System Optimization Plan while matching service levels to demand.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
