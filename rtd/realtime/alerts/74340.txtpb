cause: UNKNOWN_CAUSE
header_text {
  translation {
    text: "DASH Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "It is proposed to reduce to summer levels of service and make schedule adjustments on weekdays, Saturdays and Sundays/Holidays. It is also proposed to update the service pattern to terminate at Caterbury Dr/Willoughby Blvd between 7:00 a.m.– 7:00 p.m. Outside of these hours the eastern terminal would be Lafayette Park-n-Ride.\r\n\nReason: Proposed changes account for seasonal demand changes and would improve on-time performance.\r\n\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
