cause: MAINTENANCE
effect: OTHER_EFFECT
header_text {
  translation {
    text: "A Line Trip 8:00 pm from Union Station Track 1 and 20 other trips experiencing up to 15 minute delays today due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n8:00 pm from Union Station Track 1\r\n8:30 pm from Union Station Track 1\r\n9:00 pm from Union Station Track 1\r\n9:30 pm from Union Station Track 1\r\n10:00 pm from Union Station Track 1\r\n10:30 pm from Union Station Track 1\r\n11:00 pm from Union Station Track 1\r\n11:30 pm from Union Station Track 1\r\n12:00 am from Union Station Track 1\r\n12:30 am from Union Station Track 1\r\n\nAffected westbound trips:\r\n8:27 pm from Denver Airport Station\r\n8:57 pm from Denver Airport Station\r\n9:27 pm from Denver Airport Station\r\n9:57 pm from Denver Airport Station\r\n10:27 pm from Denver Airport Station\r\n10:57 pm from Denver Airport Station\r\n11:27 pm from Denver Airport Station\r\n11:57 pm from Denver Airport Station\r\n12:27 am from Denver Airport Station\r\n12:57 am from Denver Airport Station\r\n1:27 am from Denver Airport Station\r\n\nAffected stops:\r\n61st / Pena Station\r\nDenver Airport Station"
    language: "en"
  }
}
