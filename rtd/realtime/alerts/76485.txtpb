  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n6:37 am from Littleton / Mineral Ave Station\r\n\nAffected southbound trips:\r\n7:15 am from 18th & Stout Station\r\n\nAffected stops:\r\nEvans Station\r\nI-25 / Broadway Station\r\nAlameda Station\r\n10th / Osage Station\r\nColfax at Auraria Station\r\nTheatre District / Convention Center\r\n18th St / California Station\r\n18th St / Stout Station"
    language: "en"
  }
}
