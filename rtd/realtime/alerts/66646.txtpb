cause: MAINTENANCE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "D Line notice: from Tue Sep 9 through Thu Sep 11 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD will perform necessary maintenance affecting a portion of D Line light rail service beginning Tuesday, Sept. 9 through Thursday, Sept. 11. Crews will replace overhead wires that provide power to the light rail trains.\r\n\nBus shuttles will replace D Line service between Littleton•Mineral and Evans stations. Customers should anticipate longer travel times during the wire replacement. Work is weather dependent.\r\n\nBoarding for bus shuttles will take place at the following station locations:\r\n\n    Littleton•Mineral Station: Gate A\r\n    Littleton•Downtown Station: Gates on Prince Street (Gate F-southbound; Gate E-northbound)\r\n    Oxford•City of Sheridan Station: Bus bridge gate\r\n    Englewood Station: Gate E\r\n    Evans Station – Gate C\r\n\nDuring the work, trains will operate scheduled service between Evans and Union stations. Full service on the D Line will resume Friday, Sept. 12."
    language: "en"
  }
}
