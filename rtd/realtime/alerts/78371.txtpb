  translation {
    text: "Affected northbound trips:\r\n9:01 am from 16th & California Station\r\n9:46 am from 16th & California Station\r\n10:31 am from 16th & California Station\r\n11:16 am from 16th & California Station\r\n12:01 pm from 16th & California Station\r\n12:46 pm from 16th & California Station\r\n1:31 pm from 16th & California Station\r\n2:16 pm from 16th & California Station\r\n\nAffected southbound trips:\r\n9:28 am from 30th & Downing Station\r\n10:13 am from 30th & Downing Station\r\n10:58 am from 30th & Downing Station\r\n11:43 am from 30th & Downing Station\r\n12:28 pm from 30th & Downing Station\r\n1:13 pm from 30th & Downing Station\r\n1:58 pm from 30th & Downing Station"
