  translation {
    text: "Affected northbound trips:\r\n8:00 am from Ridgegate Parkway Station\r\n8:30 am from Ridgegate Parkway Station\r\n9:00 am from Ridgegate Parkway Station\r\n9:15 am from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n8:27 am from Peoria Station\r\n8:57 am from Peoria Station\r\n9:12 am from Peoria Station\r\n9:27 am from Peoria Station"
    language: "en"
  }
}
