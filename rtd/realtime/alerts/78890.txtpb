description_text {
  translation {
    text: "Change\r\nRestore 30-minute service frequency on weekdays from 6:00–9:00 a.m. and 3:00–6:00 p.m.\r\n\nReason\r\nProvides additional service to better match demand and improve reliability during the busiest travel periods.\r\n\nSurvey Results\r\nOut of 83 respondents, 91% reported a positive impact from the change, 6% indicated it had no impact, and 2% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject"
    language: "en"
  }
}
