  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n11:30 am from Ridgegate Parkway Station\r\n11:45 am from Ridgegate Parkway Station\r\n2:00 pm from Ridgegate Parkway Station\r\n2:15 pm from Ridgegate Parkway Station\r\n4:30 pm from Ridgegate Parkway Station\r\n4:45 pm from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n12:42 pm from Peoria Station\r\n12:57 pm from Peoria Station\r\n3:12 pm from Peoria Station\r\n3:27 pm from Peoria Station\r\n5:42 pm from Peoria Station\r\n5:57 pm from Peoria Station"
    language: "en"
  }
}
