header_text {
  translation {
    text: "Route 228A service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nReduction of operating hours on weekdays to 7:00 a.m.–9:00 p.m. and weekends to 8:00 a.m.–7:00 p.m., while discontinuing the following low-ridership evening trips: Weekday: 9:07 p.m. northbound and 9:17 p.m. southbound (average 2.5 boardings) Saturday: 8:07 p.m. northbound and 8:13 p.m. southbound (average 2.5 boardings) Sunday: 8:07 p.m. northbound and 8:13 p.m. southbound: (average 3 boardings)\r\n\nReason\r\nVery low utilization makes these trips inefficient.\r\n\nSurvey Results\r\nOut of 11 respondents, 9% reported a positive impact from the change, 55% indicated it had no impact, and 36% perceived the change negatively."
    language: "en"
  }
}
