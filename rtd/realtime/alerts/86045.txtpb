effect: OTHER_EFFECT
header_text {
  translation {
    text: "Board A Line Trip 11:30 pm from Union Station Track 1 and 6 other trips on track today due to maintenance. "
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n11:30 pm from Union Station Track 1\r\n12:00 am from Union Station Track 1\r\n12:30 am from Union Station Track 1\r\n\nAffected westbound trips:\r\n11:57 pm from Denver Airport Station\r\n12:27 am from Denver Airport Station\r\n12:57 am from Denver Airport Station\r\n1:27 am from Denver Airport Station\r\n\nAffected stops:\r\n38th / Blake Station\r\n40th / Colorado Station\r\nCentral Park Station"
    language: "en"
  }
}
