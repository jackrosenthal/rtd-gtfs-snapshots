  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n5:28 am from 18th & Stout Station\r\n\nAffected northbound trips:\r\n6:37 am from Florida Station\r\n\nAffected stops:\r\nI-25 / Broadway Station\r\nAlameda Station\r\n10th / Osage Station\r\nColfax at Auraria Station\r\nTheatre District / Convention Center\r\n16th Street / California Station\r\n18th St / California Station\r\n18th St / Stout Station\r\n16th Street / Stout Station"
    language: "en"
  }
}
