header_text {
  translation {
    text: "Route 49 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nIf approved, Route ART would be discontinued and its service area would be served by Route 49. The new Route 49 would provide additional connections and operate from 5:00 a.m. to 9:00 p.m. at 30-minute frequency, with 60-minute frequency from 9 p.m. to midnight on weekdays and Saturdays. Sunday service would operate every 30 minutes from 6:00 a.m. to 8:00 p.m. and every 60 minutes from 8:00 p.m. to 11:00 p.m.\r\n\nReason\r\nCreate a more connected route by combining Routes 49 and ART while providing service throughout the day and evening to better align with customer travel needs."
    language: "en"
  }
}
severity_level: WARNING
