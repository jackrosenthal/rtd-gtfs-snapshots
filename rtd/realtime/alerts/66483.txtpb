header_text {
  translation {
    text: "The 104th Ave & Revere St Park-n-Ride is on privately owned, leased land and has been sold to a private developer. The last day for RTD customer parking is Sunday, September 7th."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD is working to secure replacement parking. Updates will be posted when an agreement is finalized. This closure is for the Park-n-Ride only. Bus service is not impacted at the two stops serving 104th Ave & Revere St.\r\n\nAffected routes:\r\n104L"
    language: "en"
  }
}
