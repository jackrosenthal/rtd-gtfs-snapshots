effect: DETOUR
header_text {
  translation {
    text: "Shuttle buses replacing W Line Trip 12:22 am from Union Station Track 12 and 5 other trips due to track maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n12:22 am from Union Station Track 12\r\n12:52 am from Union Station Track 12\r\n1:22 am from Union Station Track 12\r\n1:52 am from Union Station Track 12\r\n\nAffected eastbound trips:\r\n12:25 am from Jeffco Government Center Station\r\n12:55 am from Jeffco Government Center Station\r\n\nAffected stops:\r\nJefferson CO Government-Golden Station\r\nRed Rocks College Station"
    language: "en"
  }
}
