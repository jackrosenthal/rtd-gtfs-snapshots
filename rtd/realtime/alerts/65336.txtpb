description_text {
  translation {
    text: "Affected northbound trips:\r\n3:12 pm from Florida Station to 18th & California Station\r\n5:12 pm from Florida Station to 18th & California Station\r\n7:12 pm from Florida Station to 18th & California Station\r\n11:12 pm from Florida Station to 18th & California Station\r\n\nAffected southbound trips:\r\n4:00 pm from 18th & Stout Station to Florida Station\r\n6:00 pm from 18th & Stout Station to Florida Station\r\n10:00 pm from 18th & Stout Station to Florida Station"
    language: "en"
  }
}
