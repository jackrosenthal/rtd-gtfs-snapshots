  translation {
    text: "Affected stops:\r\nCoffman St & 4th Ave (#35562) (eastbound)\r\nCoffman St & 6th Ave (#35564) (eastbound)\r\n8th & Coffman PnR Gate F (#35567) (eastbound)\r\n8th & Coffman PnR Gate C (#17798) (westbound)\r\nCoffman St & 6th Ave (#35563) (westbound)\r\nCoffman St & 4th Ave (#35561) (westbound)\r\n\nBuses will service stops at Main St & 8th Ave. \r\n\nFor eastbound Route 323 get on/off buses at:\r\n3rd Ave & Terry St (#11080)\r\nKimbark St & Longs Peak Ave (#25653)\r\n\nFor westbound Route 323 get on/off buses at:\r\nE 9th Ave & Kimbark St (#34214)\r\n3rd Ave & Coffman St (#11076)"
    language: "en"
  }
}
