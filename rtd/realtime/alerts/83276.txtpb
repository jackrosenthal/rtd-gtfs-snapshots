header_text {
  translation {
    text: "Route 9 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nBus stops will be realigned to serve alternating \"Z\" stops in Downtown Denver, with service at Union Station relocating to Gate 9. The following stops will no longer be served in the Eastbound direction: 15th St & Tremont Pl (17699), 15th St & California St (17702), and 15th St & Curtis St (17705). The following stops will no longer be served in the Westbound direction: 17th St & Champa St (17714) and 17th St & Welton St (17711).\r\n\nReason\r\nBetter serve alternating stops in Downtown Denver. The 9 will serve the same stops as the routes 0 and 52. So customers headed to south can wait at these bus stops and choose between any of those three route options, whichever arrives next.\r\n\nSurvey Results\r\nOut of 14 respondents, 50% reported a positive impact from the change, 36% indicated it had no impact, and 14% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
