  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n7:00 am from 18th & Stout Station to Florida Station\r\n9:00 am from 18th & Stout Station to Florida Station\r\n11:00 am from 18th & Stout Station to Florida Station\r\n1:00 pm from 18th & Stout Station to Florida Station\r\n3:00 pm from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n8:12 am from Florida Station to 18th & California Station\r\n10:12 am from Florida Station to 18th & California Station\r\n12:12 pm from Florida Station to 18th & California Station\r\n2:12 pm from Florida Station to 18th & California Station"
    language: "en"
  }
}
