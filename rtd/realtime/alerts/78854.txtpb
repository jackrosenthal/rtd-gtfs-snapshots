header_text {
  translation {
    text: "Route 22 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nThe new Route 22 will serve the western segment of the former Route 21, west of Evans Station.\r\n\nReason\r\nProvides a clear, separate route for the western segment as part of RTD\'s System Optimization Plan.\r\n\nSurvey Results\r\nOut of 22 respondents, 78% reported a positive impact from the change, 18% indicated it had no impact, and 5% perceived the change negatively."
    language: "en"
  }
}
