  translation {
    text: "Buses will detour when construction barricades are blocking Hampden & Logan area. Normal route when road is open. \r\n\nAffected stops:\r\nHampden Ave & S. Pearl St (#14168) (northbound)\r\nHampden Ave & S Pearl St (#14180) (southbound)\r\nHampden Ave & S Pennsylvania St (#14169) (southbound)\r\n\nFor northbound Route 12 get on/off buses at:\r\nHampden Ave & S Sherman St (#20173)\r\nHampden Ave & S Clarkson St (#14134)\r\n\nFor southbound Route 12 get on/off buses at:\r\nHampden Ave & S Emerson St (#34368)\r\nHampden Ave & S Sherman St (#25212)"
    language: "en"
  }
}
