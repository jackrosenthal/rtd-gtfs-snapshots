header_text {
  translation {
    text: "DASH service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nReduce to summer levels of service with schedule adjustments on weekdays, Saturdays and Sundays/Holidays. Service pattern will be changed to terminate at Caterbury Dr/Willoughby Blvd between 7:00 a.m.– 7:00 p.m. Outside of these hours the eastern terminal will be Lafayette Park-n-Ride.\r\n\nReason\r\nAccounts for seasonal demand and improves on-time performance.\r\n\nSurvey Results\r\nOut of 14 respondents, 7% reported a positive impact from the change, 43% indicated it had no impact, and 50% perceived the change negatively."
    language: "en"
  }
}
