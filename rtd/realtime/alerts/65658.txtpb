  translation {
    text: "Affected westbound trips:\r\n5:37 am from Union Station Track 12 to Jeffco Government Center Station\r\n7:37 am from Union Station Track 12 to Jeffco Government Center Station\r\n9:37 am from Union Station Track 12 to Jeffco Government Center Station\r\n11:37 am from Union Station Track 12 to Jeffco Government Center Station\r\n\nAffected eastbound trips:\r\n6:49 am from Jeffco Government Center Station to Union Station Track 11\r\n8:49 am from Jeffco Government Center Station to Union Station Track 11\r\n10:49 am from Jeffco Government Center Station to Union Station Track 11\r\n12:49 pm from Jeffco Government Center Station to Union Station Track 11"
