header_text {
  translation {
    text: "E Line Trip 3:25 pm from Union Station Track 12 to Ridgegate Parkway Station and 1 other trip cancelled today due to mechanical issue. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n3:25 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n\nAffected northbound trips:\r\n4:39 pm from Ridgegate Parkway Station to Union Station Track 11\r\n\nAffected stops:\r\nRidgegate Parkway Station\r\nLone Tree City Center Station\r\nSky Ridge Station\r\nLincoln Station\r\nCounty Line Station\r\nDry Creek Station\r\nArapahoe at Village Center Station\r\nOrchard Station\r\nBelleview Station\r\nSouthmoor Station\r\nYale Station\r\nColorado Station\r\nUniversity of Denver Station\r\nLouisiana / Pearl Station\r\nI-25 / Broadway Station\r\nAlameda Station\r\n10th / Osage Station\r\nAuraria West Campus Station\r\nEmpower Field at Mile High"
    language: "en"
  }
}
