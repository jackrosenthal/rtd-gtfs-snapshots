  translation {
    text: "Crews will be preforming track maintenance near affected stations. Trains will operate on a single track during the work, please see other service alerts for details during the work times and listen to station announcements for details. \r\n\nAffected stops:\r\n60th / Sheridan - Arvada Gold Strike Station\r\nClear Creek / Federal Station"
    language: "en"
  }
}
