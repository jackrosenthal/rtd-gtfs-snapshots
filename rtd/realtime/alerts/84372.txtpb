  translation {
    text: "Affected westbound trips:\r\n6:48 am from Erie Community Center\r\n8:25 am from Lafayette PnR Gate B\r\n10:06 am from Boulder Technical Education Center\r\n11:26 am from Lafayette PnR Gate B\r\n1:02 pm from Boulder Technical Education Center\r\n\nAffected eastbound trips:\r\n7:32 am from Downtown Boulder Station Gate M\r\n9:17 am from Downtown Boulder Station Gate M\r\n10:32 am from Downtown Boulder Station Gate M\r\n12:17 pm from Downtown Boulder Station Gate M"
    language: "en"
  }
}
