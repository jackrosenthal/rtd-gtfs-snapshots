cause: UNKNOWN_CAUSE
header_text {
  translation {
    text: "Route 20 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "It is proposed to split the existing Route 20 into Route 20 and Route 23, with Route 20 serving the eastern portion of the route. Decatur•Federal would serve as the western terminal via 15th St., Platte St., Water St., I-25, West Colfax Avenue, and Federal Blvd. Seasonal tripper service reinstated with morning tripper times adjusted.\r\n\nReason\r\n\nProvide bus connection from Downtown to Decatur/Federal to Replace Route 15L. Better serve East High School morning bell times."
    language: "en"
  }
}
