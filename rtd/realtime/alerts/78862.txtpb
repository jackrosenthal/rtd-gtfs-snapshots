}
description_text {
  translation {
    text: "Change\r\nIncrease weekday peak service frequency from every 15 minutes to every 7.5 minutes between Central Park Station and 11th–Larimer (Auraria Campus).\r\n\nReason\r\nCompensates for the suspension of the L Line during the Downtown Rail Reconstruction Project.\r\n\nSurvey Results\r\nOut of 22 respondents, 82% reported a positive impact from the change, 14% indicated it had no impact, and 5% perceived the change negatively."
    language: "en"
  }
}
