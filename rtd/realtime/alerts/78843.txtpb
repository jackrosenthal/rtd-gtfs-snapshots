header_text {
  translation {
    text: "Route 15 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nExtension of route to serve the Amazon warehouse at 21000 E. 13th Avenue in Aurora, with changes to weekday, Saturday and Sunday/Holiday schedules.\r\n\nReason\r\nChanges account for the construction impacts of Colfax Bus Rapid Transit (BRT) Project, and provides new connections to a major employment center with the Colfax–Picadilly traffic signal expected to be operational.\r\n\nSurvey Results\r\nOut of 37 respondents, 65% reported a positive impact from the change, 35% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
