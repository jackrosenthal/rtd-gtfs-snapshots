  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n1:55 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n\nAffected northbound trips:\r\n3:09 pm from Ridgegate Parkway Station to Union Station Track 11\r\n\nAffected stops:\r\nAlameda Station\r\n10th / Osage Station\r\nAuraria West Campus Station\r\nEmpower Field at Mile High\r\nBall Arena / Elitch Gardens Station\r\nUnion Station"
    language: "en"
  }
}
