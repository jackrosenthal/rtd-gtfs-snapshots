header_text {
  translation {
    text: "E Line Trip 5:56 pm from Union Station Track 12 and 1 other trip cancelled today due to mechanical issue. Check trip status using NextRide, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n5:56 pm from Union Station Track 12\r\n\nAffected northbound trips:\r\n7:10 pm from Ridgegate Parkway Station\r\n\nAffected stops:\r\nRidgegate Parkway Station\r\nLone Tree City Center Station\r\nSky Ridge Station\r\nLincoln Station\r\nCounty Line Station\r\nDry Creek Station\r\nArapahoe at Village Center Station\r\nOrchard Station\r\nBelleview Station"
    language: "en"
  }
}
