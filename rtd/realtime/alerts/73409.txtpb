cause: MAINTENANCE
effect: DETOUR
header_text {
  translation {
    text: "Shuttle buses replacing G Line eastbound from Sat Jan 31 through Sun Feb 1 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "B and G Lines: RTD will provide bus shuttle service for B and G Line customers between Union Station and 41st-Fox Station.\r\n\n    B and G Line customers at Union Station can access the shuttle at Gate B22 in the underground bus concourse\r\n    B and G Line customers at 41st-Fox Station can access the shuttle at Gate D\r\n    B Line service will operate as normal between 41st-Fox Station and Westminster Station\r\n    G Line service will operate as normal between 41st-Fox Station and Wheat Ridge-Ward Road Station\r\n\nAffected stops:\r\n41st & Fox Station Track 2 (#34559)\r\nUnion Station Track 8 (#34782)"
    language: "en"
  }
}
