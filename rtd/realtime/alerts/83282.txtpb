header_text {
  translation {
    text: "Route 20 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nIt is proposed to split the existing Route 20 into Route 20 and Route 23, with Route 20 serving the eastern portion of the route. Decatur•Federal would serve as the western terminal via 15th St., Platte St., Water St., I-25, West Colfax Avenue, and Federal Blvd. Seasonal tripper service reinstated with morning tripper times adjusted.\r\n\nReason\r\nProvide bus connection from Downtown to Decatur/Federal to Replace Route 15L. Better serve East High School morning bell times.\r\n\nSurvey Results\r\nOut of 43 respondents, 40% reported a positive impact from the change, 14% indicated it had no impact, and 47% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
