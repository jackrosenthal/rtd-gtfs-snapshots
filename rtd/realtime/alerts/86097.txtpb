header_text {
  translation {
    text: "Board A Line Trip 10:27 pm from Denver Airport Station and 11 other trips on track 1 today due to maintenance. "
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n10:27 pm from Denver Airport Station\r\n10:57 pm from Denver Airport Station\r\n11:27 pm from Denver Airport Station\r\n11:57 pm from Denver Airport Station\r\n12:27 am from Denver Airport Station\r\n12:57 am from Denver Airport Station\r\n1:27 am from Denver Airport Station\r\n\nAffected eastbound trips:\r\n10:30 pm from Union Station Track 1\r\n11:00 pm from Union Station Track 1\r\n11:30 pm from Union Station Track 1\r\n12:00 am from Union Station Track 1\r\n12:30 am from Union Station Track 1\r\n\nAffected stops:\r\n40th / Colorado Station"
    language: "en"
  }
}
severity_level: WARNING
