  translation {
    text: "Change\r\nMinor changes to weekday, Saturday and Sunday/Holiday schedules with reinstatement of seasonal tripper service.\r\n\nReason\r\nImprove on-time performance and service reliability while aligning with seasonal ridership levels at South High School.\r\n\nSurvey Results\r\nOut of 8 respondents, 50% reported a positive impact from the change, 50% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
