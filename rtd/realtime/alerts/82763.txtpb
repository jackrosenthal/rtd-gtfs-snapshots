  translation {
    text: "Affected northbound trips:\r\n5:40 am from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n6:41 am from Union Station Track 12\r\n\nAffected stops:\r\nSouthmoor Station\r\nYale Station\r\nColorado Station\r\nUniversity of Denver Station\r\nLouisiana / Pearl Station\r\nI-25 / Broadway Station\r\nAlameda Station\r\n10th / Osage Station\r\nAuraria West Campus Station\r\nEmpower Field at Mile High\r\nBall Arena / Elitch Gardens Station\r\nUnion Station"
