header_text {
  translation {
    text: "D Line service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nThe D Line, which is currently not operating, will be permanently discontinued once the Downtown Rail Reconstruction Project is complete.\r\n\nReason\r\nPermanent reinstatement of the C Line will provide service between Littleton•Mineral Station and Union Station, and provide the ability to transfer to rail lines serving the Downtown Loop via the I-25•Broadway, Alameda, and 10th•Osage stations.\r\n\nSurvey Results\r\nOut of 265 respondents, 11% reported a positive impact from the change, 7% indicated it had no impact, and 82% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
