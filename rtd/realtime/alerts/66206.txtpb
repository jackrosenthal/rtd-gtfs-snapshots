  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n4:45 am from Evans Station to Florida Station\r\n6:30 am from 18th & Stout Station to Florida Station\r\n8:30 am from 18th & Stout Station to Florida Station\r\n10:30 am from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n5:39 am from Florida Station to 18th & California Station\r\n7:39 am from Florida Station to 18th & California Station\r\n9:39 am from Florida Station to 18th & California Station\r\n11:39 am from Florida Station to 18th & California Station"
    language: "en"
  }
}
