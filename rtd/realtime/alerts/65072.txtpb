header_text {
  translation {
    text: "Shuttle buses replacing D Line northbound from Tue Aug 12 to Thu Aug 14 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Boarding for bus shuttles will take place at the following station locations:\r\n\n    Littleton•Mineral Station: Gate A\r\n    Littleton•Downtown Station: Gates on Prince Street (Gate F-southbound; Gate B-northbound)\r\n    Oxford•City of Sheridan Station: Bus bridge gate\r\n    Englewood Station: Gate E\r\n    Evans Station – Gate C\r\n\nFull service on the D Line will resume Friday, Aug. 15.\r\n\nAffected stops:\r\nLittleton / Mineral Ave Station (#24896)\r\nLittleton / Downtown Station (#24894)\r\nOxford - City of Sheridan Station (#24892)\r\nEnglewood Station (#24890)"
    language: "en"
  }
}
