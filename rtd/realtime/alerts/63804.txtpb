cause: TECHNICAL_PROBLEM
effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 1:12 pm from Denver Airport Station to Union Station Track 1 and 11 other trips cancelled today due to signal problem. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n1:12 pm from Denver Airport Station to Union Station Track 1\r\n1:42 pm from Denver Airport Station to Union Station Track 1\r\n2:12 pm from Denver Airport Station to Union Station Track 1\r\n2:42 pm from Denver Airport Station to Union Station Track 1\r\n3:12 pm from Denver Airport Station to Union Station Track 1\r\n3:42 pm from Denver Airport Station to Union Station Track 1\r\n\nAffected eastbound trips:\r\n1:15 pm from Union Station Track 1 to Denver Airport Station\r\n1:45 pm from Union Station Track 1 to Denver Airport Station\r\n2:15 pm from Union Station Track 1 to Denver Airport Station\r\n2:45 pm from Union Station Track 1 to Denver Airport Station\r\n3:15 pm from Union Station Track 1 to Denver Airport Station\r\n3:45 pm from Union Station Track 1 to Denver Airport Station"
    language: "en"
  }
}
