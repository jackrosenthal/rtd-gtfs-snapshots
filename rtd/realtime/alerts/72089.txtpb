  translation {
    text: "Change\r\nThe southbound, weekday trip currently departing Central Park & 54th at 4:41 p.m. will be rescheduled to depart at 3:36 p.m.\r\n\nReason\r\nSynchronize trip with Northfield High School bell time.\r\n\nSurvey Results\r\nOut of 10 respondents, 50% reported a positive impact from the change, 30% indicated it had no impact, and 20% perceived the change negatively."
    language: "en"
  }
