header_text {
  translation {
    text: "Route 52 detoured from Mon Jun 8 through Mon Jun 22 due to construction on W 52nd Ave between Marshall St and Sheridan Blvd"
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected stops:\r\nW 52nd Ave & Ingalls St (#19301) (eastbound)\r\nW 52nd Ave & Gray St (#11379) (eastbound)\r\nW 52nd Ave & Clear Creek Dr (#11371) (eastbound)\r\nW 52nd Ave & Benton St (#21682) (eastbound)\r\nW 52nd Ave & Benton St (#11382) (westbound)\r\nW 52nd Ave & Clear Creek Dr (#11372) (westbound)\r\nW 52nd Ave & Eaton St (#11378) (westbound)\r\nW 52nd Ave & Ingalls St (#19126) (westbound)\r\n\nFor eastbound Route 52 get on/off buses at:\r\nW 52nd Ave & Marshall St (#11380)\r\nW 52nd Ave & Sheridan Blvd (#11381)\r\n\nFor westbound Route 52 get on/off buses at:\r\nW 52nd Ave & Sheridan Blvd (#23437)\r\nW 52nd Ave & Marshall St (#20818)"
    language: "en"
  }
}
