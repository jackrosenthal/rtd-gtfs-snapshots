  }
}
description_text {
  translation {
    text: "Affected stops:\r\nMain St & Gateway Dr (#35529) (northbound)\r\nOld Rail Way & Gateway Dr (#35528) (northbound)\r\nMarshall Rd & Main St (#35525) (northbound)\r\nMarshall Rd & Creek View Way (#35523) (northbound)\r\nMarshall Rd & Creek View Way (#35524) (southbound)\r\nMarshall Rd & Main St (#35526) (southbound)\r\nOld Rail Way & Gateway Dr (#35527) (southbound)\r\nMain St & Gateway Dr (#35406) (southbound)\r\n\nFor northbound Route 228F get on/off buses at:\r\nRock Creek Pkwy & McCaslin Blvd (#25079)\r\nUS 36 & McCaslin Station Gate C (#33738)\r\n\nFor southbound Route 228F get on/off buses at:\r\nUS 36 & McCaslin Station Gate C (#33738)\r\nRock Creek Pkwy & McCaslin Blvd (#25537)"
    language: "en"
  }
}
