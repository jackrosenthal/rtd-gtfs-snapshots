effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 10:30 am from Union Station Track 1 and 11 other trips cancelled today due to signal problem. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected direction: Eastbound\r\n\nAffected eastbound trips:\r\n10:30 am from Union Station Track 1\r\n11:00 am from Union Station Track 1\r\n11:30 am from Union Station Track 1\r\n12:00 pm from Union Station Track 1\r\n12:30 pm from Union Station Track 1\r\n1:00 pm from Union Station Track 1\r\n1:30 pm from Union Station Track 1\r\n2:00 pm from Union Station Track 1\r\n2:30 pm from Union Station Track 1\r\n3:00 pm from Union Station Track 1\r\n3:30 pm from Union Station Track 1\r\n4:00 pm from Union Station Track 1"
    language: "en"
  }
}
