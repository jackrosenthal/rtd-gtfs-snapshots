  translation {
    text: "To allow for connections to Boulder County Hessie Shuttle, a partnership between Boulder County and RTD, RTD\'s route NB will provide connections at Nederland High School on Fridays, Saturdays and Sundays/Holidays by providing service directly to Nederland High School.\r\n\nMore information can be found on the Hessie Shuttle webpage, https://www.bouldercoloradousa.com/outdoors/hiking/hiker-shuttles/hessie-trailhead-shuttle/"
    language: "en"
  }
}
