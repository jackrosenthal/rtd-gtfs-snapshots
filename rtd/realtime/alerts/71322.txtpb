header_text {
  translation {
    text: "Sunday: Supplemental Bus Shuttle Service for E Line"
    language: "en"
  }
}
description_text {
  translation {
    text: "Express bus shuttles will be added to supplement reduced E Line service north of Southmoor Station during the Broncos game. Beginning at 12:30 p.m. and continuing until 45 minutes after the end of the game, bus shuttle service will be provided between Southmoor Station (Gate A) and I-25-Broadway Station (Gate A3).\r\n\nFans can transfer to D or E lines at Broadway Station to Empower Field at Mile High Station. Our Holiday Train (S Line) will also be available at Broadway Station to take you into downtown for other holiday events. "
    language: "en"
  }
}
