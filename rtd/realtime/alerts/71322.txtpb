header_text {
  translation {
    text: "Sunday: Supplemental Bus Shuttle Service for E Line"
    language: "en"
  }
}
description_text {
  translation {
    text: "Express bus shuttles will be added to supplement reduced E Line service north of Southmoor Station during the Broncos game. Beginning at 12:30 p.m. and continuing until 45 minutes after the end of the game, bus shuttle service will be provided between Southmoor Station (Gate A) and Auraria West Station (intersection of 5th & Larimer St, bus shuttle stop).\r\n\nPlease note, Auraria West Station is closed to light rail boarding during this time. Fans will need to walk to/from the stadium. "
    language: "en"
  }
}
