description_text {
  translation {
    text: "Affected eastbound trips:\r\n3:55 pm from Jeffco Government Center Station to Union Station Track 11\r\n5:55 pm from Jeffco Government Center Station to Union Station Track 11\r\n7:55 pm from Jeffco Government Center Station to Union Station Track 11\r\n9:55 pm from Jeffco Government Center Station to Union Station Track 11\r\n11:55 pm from Jeffco Government Center Station to Union Station Track 11\r\n\nAffected westbound trips:\r\n4:52 pm from Union Station Track 12 to Jeffco Government Center Station\r\n6:52 pm from Union Station Track 12 to Jeffco Government Center Station\r\n8:52 pm from Union Station Track 12 to Jeffco Government Center Station\r\n10:52 pm from Union Station Track 12 to Jeffco Government Center Station"
    language: "en"
  }
}
