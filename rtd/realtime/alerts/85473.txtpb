description_text {
  translation {
    text: "Affected stops:\r\nS Monroe St & Evans Ave (#34608) (eastbound)\r\nBuchtel Blvd & S Monroe St (#34611) (eastbound)\r\nBuchtel Blvd & S Colorado Blvd (#12625) (eastbound)\r\nBuchtel Blvd & S Colorado Blvd (#21043) (westbound)\r\nBuchtel Blvd & S Monroe St (#23511) (westbound)\r\nS Monroe St & Evans Ave (#34609) (westbound)\r\n\nFor eastbound Route 21 get on/off buses at:\r\nEvans Ave & S Cook St (#13572)\r\nColorado Station Gate B (#26149)\r\n\nFor westbound Route 21 get on/off buses at:\r\nColorado Station Gate F (#26152)\r\nEvans Ave & S Cook St (#13573)"
    language: "en"
  }
}
