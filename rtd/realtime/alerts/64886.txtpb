  translation {
    text: "Affected southbound trips:\r\n7:54 am from Evans Station to Ridgegate Parkway Station\r\n10:11 am from Union Station Track 12 to Ridgegate Parkway Station\r\n12:26 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n2:41 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n\nAffected northbound trips:\r\n9:12 am from Ridgegate Parkway Station to Union Station Track 11\r\n11:27 am from Ridgegate Parkway Station to Union Station Track 11\r\n1:42 pm from Ridgegate Parkway Station to Union Station Track 11\r\n3:57 pm from Ridgegate Parkway Station to Union Station Track 11"
    language: "en"
  }
