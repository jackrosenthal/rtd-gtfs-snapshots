  translation {
    text: "Affected southbound trips:\r\n2:13 pm from 30th & Downing Station\r\n2:58 pm from 30th & Downing Station\r\n3:43 pm from 30th & Downing Station\r\n4:28 pm from 30th & Downing Station\r\n5:13 pm from 30th & Downing Station\r\n5:58 pm from 30th & Downing Station\r\n6:43 pm from 30th & Downing Station\r\n7:28 pm from 30th & Downing Station\r\n8:13 pm from 30th & Downing Station\r\n9:13 pm from 30th & Downing Station\r\n\nAffected northbound trips:\r\n2:31 pm from 16th & California Station\r\n3:16 pm from 16th & California Station\r\n4:01 pm from 16th & California Station\r\n4:46 pm from 16th & California Station\r\n5:31 pm from 16th & California Station\r\n6:16 pm from 16th & California Station\r\n7:01 pm from 16th & California Station\r\n7:46 pm from 16th & California Station\r\n8:31 pm from 16th & California Station\r\n9:31 pm from 16th & California Station"
