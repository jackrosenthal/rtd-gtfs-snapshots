cause: MAINTENANCE
effect: NO_SERVICE
header_text {
  translation {
    text: "R Line service suspended from Tue Jul 15 to Thu Jul 17 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected stops:\r\nLincoln Station\r\nCounty Line Station\r\nDry Creek Station\r\nArapahoe at Village Center Station\r\nOrchard Station\r\nBelleview Station\r\n\nR Line customers can connect to the E Line for travel between Southmoor and Lincoln stations\r\n\nR Line service will operate as normal between Peoria and Florida stations\r\n\nBoarding for bus shuttles will take place at the following gates:\r\n\nSouthmoor Station – Gate A\r\nDayton Station – Bus bridge sign within the bus loop\r\nNine Mile Station – Gate E\r\nIliff Station – Gate A\r\nFlorida Station – Bus bridge sign next to the station"
    language: "en"
  }
}
