    text: "Affected southbound trips:\r\n5:01 pm from 18th & Stout Station\r\n6:46 pm from 18th & Stout Station\r\n8:46 pm from 18th & Stout Station\r\n10:46 pm from 18th & Stout Station\r\n\nAffected northbound trips:\r\n6:07 pm from Littleton / Mineral Ave Station\r\n8:07 pm from Littleton / Mineral Ave Station\r\n10:07 pm from Littleton / Mineral Ave Station"
    language: "en"
  }
}
