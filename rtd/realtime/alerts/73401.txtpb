cause: UNKNOWN_CAUSE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "DASH notice: until further notice daily from 7:00 PM to 7:00 AM."
    language: "en"
  }
}
description_text {
  translation {
    text: "Beginning January 26, 2026. To provide operators an adequate break time, route DASH will end and begin it\'s route at Lafayette Park-n-Ride. A shuttle will be available, operating between Lafayette Park-n-Ride and Canterbury Dr & Willoughby Blvd.\r\n\nAffected stops:\r\nE Spaulding St & S Public Rd (#20012) (eastbound)\r\nE Spaulding St & Dove Cove (#22058) (eastbound)\r\nMerlin Dr & E Spaulding St (#35494) (eastbound)\r\nEmma St & 120th St (#35504) (eastbound)\r\nS 120th St & Canterbury Dr (#35496) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (westbound)\r\nManhattan Cir & South Boulder Rd (#25972) (westbound)\r\nCanterbury Dr & Emma St (#35566) (westbound)\r\nMerlin Dr & E Spaulding St (#35495) (westbound)\r\nE Spaulding St & Dove St (#17909) (westbound)\r\nE Spaulding St & S Public Rd (#17910) (westbound)"
    language: "en"
  }
}
