url {
  translation {
    text: "https://www.rtd-denver.com/community/news/access-to-rtd-s-orchard-station-pedestrian-bridge-limited-during-local-improvements-to-orchard-station-park"
    language: "en"
  }
}
header_text {
  translation {
    text: "Change at Orchard Station beginning Thu Mar 26 due to construction."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD is coordinating with local partners Goldsmith Metropolitan District and the City of Greenwood Village to ensure customer access to light rail during a six-month project to redevelop the green space at Orchard Station Park beginning March 26. Light rail service will not be affected by the project.\r\n\nDuring the initial phase of work, which includes construction of a sound wall along I-25, crews will work to minimize disruptions and maintain access whenever possible. The park will be closed during the second phase, which includes improvements to landscaping and walkways and creation of a new pond and seating area.\r\n\nWhile the project is underway, light rail customers can follow posted detours around the perimeter of the construction site to travel to and from the Orchard Station pedestrian bridge."
    language: "en"
  }
}
severity_level: WARNING
