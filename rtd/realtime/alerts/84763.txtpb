  translation {
    text: "Change\r\nIncrease weekday frequency to 30 minutes between Aurora Metro Center and Alameda Station from 6:00 a.m. to 8:00 p.m., and to 15 minutes between Federal Center Station and Alameda Station from 6:00 a.m. to 6:00 p.m.\r\n\nReason\r\nProvide more frequent service during periods of higher customer demand and improve connections between Alameda Station and the Aurora and Federal Center areas."
    language: "en"
  }
}
