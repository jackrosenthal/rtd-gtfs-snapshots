cause: UNKNOWN_CAUSE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "RTD will conduct a joint emergency preparedness drill in coordination with local emergency services on Wednesday, September 17, from 10 a.m. to 2 p.m., along the G Line between Olde Town Arvada and Pecos Junction stations. "
    language: "en"
  }
}
description_text {
  translation {
    text: "During the exercise, there will be no rail service on the G Line between Olde Town Arvada and Pecos Junction stations. Bus shuttles will provide service between these stations throughout the drill period. Customers should allow extra travel time and look for posted signage at stations.\r\n\nGate assignments for shuttle service are as follows:\r\n\nOlde Town Arvada Station: Gate A\r\n60th & Sheridan-Arvada Gold Strike Station: Gate A\r\nClear Creek-Federal Station: Gate C\r\nPecos Junction Station: Gate A\r\n\nService Alerts and station signage will provide real-time updates. G Line service will resume following completion of the drill exercise. Customers seeking alternative travel options during the drill are encouraged to check RTD’s Next Ride app before traveling and sign up for Service Alerts for specific route information.\r\n"
    language: "en"
  }
}
