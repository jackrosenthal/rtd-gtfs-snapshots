  translation {
    text: "Affected northbound trips:\r\n10:07 am from Littleton / Mineral Ave Station\r\n11:52 am from Littleton / Mineral Ave Station\r\n1:37 pm from Littleton / Mineral Ave Station\r\n3:22 pm from Littleton / Mineral Ave Station\r\n5:07 pm from Littleton / Mineral Ave Station\r\n\nAffected southbound trips:\r\n10:48 am from Union Station Track 12\r\n12:33 pm from Union Station Track 12\r\n2:18 pm from Union Station Track 12\r\n4:03 pm from Union Station Track 12\r\n5:48 pm from Union Station Track 12"
