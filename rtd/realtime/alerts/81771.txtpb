cause: TECHNICAL_PROBLEM
effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 4:12 pm from Denver Airport Station and 11 other trips cancelled today due to an earlier mechanical problem. Check trip status using NextRide, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n4:12 pm from Denver Airport Station\r\n4:42 pm from Denver Airport Station\r\n5:12 pm from Denver Airport Station\r\n5:42 pm from Denver Airport Station\r\n6:12 pm from Denver Airport Station\r\n6:42 pm from Denver Airport Station\r\n7:12 pm from Denver Airport Station\r\n\nAffected eastbound trips:\r\n4:15 pm from Union Station Track 1\r\n4:45 pm from Union Station Track 1\r\n5:15 pm from Union Station Track 1\r\n5:45 pm from Union Station Track 1\r\n6:15 pm from Union Station Track 1"
    language: "en"
  }
}
