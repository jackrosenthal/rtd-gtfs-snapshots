  translation {
    text: "Affected northbound trips:\r\n9:40 am from Ridgegate Parkway Station\r\n10:55 am from Ridgegate Parkway Station\r\n12:10 pm from Ridgegate Parkway Station\r\n1:25 pm from Ridgegate Parkway Station\r\n2:40 pm from Ridgegate Parkway Station\r\n3:55 pm from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n10:12 am from Southmoor Station\r\n11:27 am from Southmoor Station\r\n12:42 pm from Southmoor Station\r\n1:57 pm from Southmoor Station\r\n3:12 pm from Southmoor Station\r\n4:27 pm from Southmoor Station"
