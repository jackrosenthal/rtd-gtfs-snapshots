effect: DETOUR
header_text {
  translation {
    text: "Route 205 detoured from Wed Nov 5 through Wed Jan 28 due to road closure on 63rd Street for replacement of the water culvert. "
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected stops:\r\nJay Rd & Spine Rd (#19327) (eastbound)\r\n63rd St & Jay Rd (#19807) (eastbound)\r\n63rd St & Twin Lakes Rd (#19808) (eastbound)\r\n63rd St & Nautilus Dr (#19809) (eastbound)\r\n63rd St & Gunbarrel Ave (#19690) (westbound)\r\n63rd St & Notting Hill Gate (#19691) (westbound)\r\nJay Rd & 63rd St (#14641) (westbound)\r\n\nFor eastbound Route 205 get on/off buses at:\r\nJay Rd & 57th St (#14637)\r\n63rd St & Longbow Dr (#19810)\r\n\nFor westbound Route 205 get on/off buses at:\r\n63rd St & Longbow Dr (#19689)\r\nJay Rd & Spine Rd (#19331)"
    language: "en"
  }
}
