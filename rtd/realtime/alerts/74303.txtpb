header_text {
  translation {
    text: "Route 0L Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Extend hours of operation, adding weekday midday service between I-25•Broadway Station and Wade Blank Civic Center Station.\r\n\nReason: Provide additional mobility and connections for customers affected by central corridor rail service being diverted to Denver Union Station during final phases of the Downtown Rail Reconstruction Project.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
