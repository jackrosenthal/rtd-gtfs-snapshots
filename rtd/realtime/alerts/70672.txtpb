cause: UNKNOWN_CAUSE
effect: NO_SERVICE
header_text {
  translation {
    text: "Due to a non-RTD accident near Yale Station, H Line trains will be operating on 30-minute frequency between Florida and Southmoor Stations today. Check trip status using Next Ride, https://app.rtd-denver.com/alerts"
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n9:20 am from Southmoor Station\r\n9:50 am from Southmoor Station\r\n10:20 am from Southmoor Station\r\n10:50 am from Southmoor Station\r\n11:20 am from Southmoor Station\r\n11:50 am from Southmoor Station\r\n12:20 pm from Southmoor Station\r\n12:50 pm from Southmoor Station\r\n1:20 pm from Southmoor Station\r\n1:50 pm from Southmoor Station\r\n2:20 pm from Southmoor Station\r\n2:50 pm from Southmoor Station\r\n3:20 pm from Southmoor Station\r\n3:50 pm from Southmoor Station\r\n4:20 pm from Southmoor Station\r\n4:50 pm from Southmoor Station\r\n5:20 pm from Southmoor Station\r\n5:50 pm from Southmoor Station\r\n6:20 pm from Southmoor Station\r\n\nAffected northbound trips:\r\n9:28 am from Florida Station\r\n9:58 am from Florida Station\r\n10:28 am from Florida Station\r\n10:58 am from Florida Station\r\n11:28 am from Florida Station\r\n11:58 am from Florida Station\r\n12:28 pm from Florida Station\r\n12:58 pm from Florida Station\r\n1:28 pm from Florida Station\r\n1:58 pm from Florida Station\r\n2:28 pm from Florida Station\r\n2:58 pm from Florida Station\r\n3:28 pm from Florida Station\r\n3:58 pm from Florida Station\r\n4:28 pm from Florida Station\r\n4:58 pm from Florida Station\r\n5:28 pm from Florida Station\r\n5:58 pm from Florida Station"
    language: "en"
  }
}
