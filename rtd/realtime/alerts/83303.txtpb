  translation {
    text: "Route 225 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute 225 will be adjusted to return service to Willoughby Corner before 7 a.m. and after 7 p.m. while reinstating fall/winter service levels.\r\n\nReason\r\nAdjust service reflects improved operating conditions while aligning service levels with seasonal ridership levels.\r\n\nSurvey Results\r\nOut of 21 respondents, 71% reported a positive impact from the change, 24% indicated it had no impact, and 5% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
