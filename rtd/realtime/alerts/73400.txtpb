cause: UNKNOWN_CAUSE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "Route 225D notice: until further notice daily from 7:00 PM to 7:00 AM."
    language: "en"
  }
}
description_text {
  translation {
    text: "Beginning January 26, 2026. To provide operators an adequate break time, route 225D will detour to Lafayette Park-n-Ride from Baseline Road. A shuttle will be available operating between Lafayette Park-n-Ride and Canterbury Dr & Willoughby Blvd. \r\n\nAffected stops:\r\nBaseline Rd & Finch Ave (#35501) (eastbound)\r\nBaseline Rd & Burlington Ave (#35503) (eastbound)\r\nS 120th St & Canterbury Dr (#35496) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (westbound)\r\nCanterbury Dr & Emma St (#35566) (westbound)\r\nEmma St & 120th St (#35504) (westbound)\r\nBaseline Rd & Burlington Ave (#35502) (westbound)"
    language: "en"
  }
}
severity_level: WARNING
