cause: ACCIDENT
effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 6:15 am from Union Station Track 1 and 14 other trips cancelled today due to accident. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n6:15 am from Union Station Track 1\r\n6:45 am from Union Station Track 1\r\n7:15 am from Union Station Track 1\r\n7:45 am from Union Station Track 1\r\n8:15 am from Union Station Track 1\r\n8:45 am from Union Station Track 1\r\n9:15 am from Union Station Track 1\r\n9:45 am from Union Station Track 1\r\n\nAffected westbound trips:\r\n6:42 am from Denver Airport Station\r\n7:12 am from Denver Airport Station\r\n7:42 am from Denver Airport Station\r\n8:12 am from Denver Airport Station\r\n8:42 am from Denver Airport Station\r\n9:12 am from Denver Airport Station\r\n9:42 am from Denver Airport Station"
    language: "en"
  }
}
