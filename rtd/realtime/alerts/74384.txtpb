cause: TECHNICAL_PROBLEM
effect: NO_SERVICE
header_text {
  translation {
    text: "L Line Trip 2:46 pm from 16th & California Station and 14 other trips cancelled today due to congestion caused by work being performed near 30th & Downing crossing. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n2:46 pm from 16th & California Station\r\n3:31 pm from 16th & California Station\r\n4:16 pm from 16th & California Station\r\n5:01 pm from 16th & California Station\r\n5:46 pm from 16th & California Station\r\n6:31 pm from 16th & California Station\r\n7:16 pm from 16th & California Station\r\n8:01 pm from 16th & California Station\r\n\nAffected southbound trips:\r\n3:13 pm from 30th & Downing Station\r\n3:58 pm from 30th & Downing Station\r\n4:43 pm from 30th & Downing Station\r\n5:28 pm from 30th & Downing Station\r\n6:13 pm from 30th & Downing Station\r\n6:58 pm from 30th & Downing Station\r\n7:43 pm from 30th & Downing Station"
    language: "en"
  }
}
