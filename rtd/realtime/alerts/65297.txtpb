  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n11:22 am from Union Station Track 12 to Federal Center Station\r\n12:53 pm from Union Station Track 12 to Federal Center Station\r\n2:23 pm from Union Station Track 12 to Federal Center Station\r\n3:53 pm from Union Station Track 12 to Federal Center Station\r\n5:23 pm from Union Station Track 12 to Federal Center Station\r\n6:53 pm from Union Station Track 12 to Federal Center Station\r\n\nAffected eastbound trips:\r\n12:13 pm from Federal Center Station to Union Station Track 11\r\n1:44 pm from Federal Center Station to Union Station Track 11\r\n3:14 pm from Federal Center Station to Union Station Track 11\r\n4:44 pm from Federal Center Station to Union Station Track 11\r\n6:14 pm from Federal Center Station to Union Station Track 11\r\n7:44 pm from Federal Center Station to Union Station Track 11"
    language: "en"
  }
}
