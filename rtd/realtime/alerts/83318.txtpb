header_text {
  translation {
    text: "T Line service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nThe T Line (Temporary Line) will be extended northbound to serve Alameda Station, along with minor changes to weekday, Saturday, and Sunday/Holiday schedules.\r\n\nReason\r\nProvide additional Operator recovery time and improve customer connections between the T, C and E lines.\r\n\nSurvey Results\r\nOut of 36 respondents, 53% reported a positive impact from the change, 28% indicated it had no impact, and 19% perceived the change negatively. Note: Extension of the T Line to Alameda Station was not part of the Proposed Service Change."
    language: "en"
  }
}
severity_level: WARNING
