    text: "Affected eastbound trips:\r\n5:24 pm from Jeffco Government Center Station\r\n7:24 pm from Jeffco Government Center Station\r\n9:24 pm from Jeffco Government Center Station\r\n11:24 pm from Jeffco Government Center Station\r\n\nAffected westbound trips:\r\n6:23 pm from Union Station Track 12\r\n8:23 pm from Union Station Track 12\r\n10:23 pm from Union Station Track 12\r\n12:23 am from Union Station Track 12"
    language: "en"
  }
}
