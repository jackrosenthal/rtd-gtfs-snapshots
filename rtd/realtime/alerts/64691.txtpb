  translation {
    text: "Affected southbound trips:\r\n3:10 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n5:25 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n7:55 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n10:25 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n\nAffected northbound trips:\r\n4:24 pm from Ridgegate Parkway Station to Union Station Track 11\r\n6:39 pm from Ridgegate Parkway Station to Union Station Track 11\r\n9:09 pm from Ridgegate Parkway Station to Union Station Track 11"
    language: "en"
  }
