header_text {
  translation {
    text: "R Line northbound service suspended between Lincoln and Florida Stations due to overhead wire repair."
    language: "en"
  }
}
description_text {
  translation {
    text: "Board E Line for service between Lincoln and Southmoor, board bus shuttles between Southmoor and Florida Stations. R Line operating between Florida and Peoria Stations.\r\n\nAffected stops:\r\nLincoln Station (#34005)\r\nCounty Line Station (#34006)\r\nDry Creek Station (#34007)\r\nArapahoe at Village Center Station (#34008)\r\nOrchard Station (#34009)\r\nBelleview Station (#34010)\r\nDayton Station (#25974)\r\nNine Mile Station (#25987)\r\nIliff Station (#34574)"
    language: "en"
  }
}
