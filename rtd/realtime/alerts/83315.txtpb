description_text {
  translation {
    text: "Change\r\nThe C Line will be permanently reinstated once the Downtown Rail Reconstruction Project is complete.\r\n\nReason\r\nThe C Line provides a stable and consistent service pattern between Littleton•Mineral Station and Union Station to enhance the customer experience.\r\n\nSurvey Results\r\nOut of 264 respondents, 85% reported a positive impact from the change, 2% indicated it had no impact, and 13% perceived the change negatively."
    language: "en"
  }
}
