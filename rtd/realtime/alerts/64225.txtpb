header_text {
  translation {
    text: "H Line Trip 5:30 pm from 18th & Stout Station to Florida Station and 8 other trips cancelled today due to no operator available. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n5:30 pm from 18th & Stout Station to Florida Station\r\n7:30 pm from 18th & Stout Station to Florida Station\r\n9:30 pm from 18th & Stout Station to Florida Station\r\n11:30 pm from 18th & Stout Station to Florida Station\r\n1:30 am from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n6:39 pm from Florida Station to 18th & California Station\r\n8:39 pm from Florida Station to 18th & California Station\r\n10:39 pm from Florida Station to 18th & California Station\r\n12:39 am from Florida Station to 18th & California Station"
    language: "en"
  }
}
