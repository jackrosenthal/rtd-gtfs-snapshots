  translation {
    text: "Affected westbound trips:\r\n3:52 pm from Union Station Track 12\r\n5:51 pm from Union Station Track 12\r\n7:51 pm from Union Station Track 12\r\n9:51 pm from Union Station Track 12\r\n11:51 pm from Union Station Track 12\r\n\nAffected eastbound trips:\r\n4:53 pm from Jeffco Government Center Station\r\n6:53 pm from Jeffco Government Center Station\r\n8:53 pm from Jeffco Government Center Station\r\n10:53 pm from Jeffco Government Center Station"
    language: "en"
  }
}
