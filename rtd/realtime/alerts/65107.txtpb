  translation {
    text: "Affected westbound trips:\r\n9:52 am from Union Station Track 12 to Jeffco Government Center Station\r\n11:52 am from Union Station Track 12 to Jeffco Government Center Station\r\n1:52 pm from Union Station Track 12 to Jeffco Government Center Station\r\n3:52 pm from Union Station Track 12 to Jeffco Government Center Station\r\n5:52 pm from Union Station Track 12 to Jeffco Government Center Station\r\n\nAffected eastbound trips:\r\n10:54 am from Jeffco Government Center Station to Union Station Track 11\r\n12:54 pm from Jeffco Government Center Station to Union Station Track 11\r\n2:55 pm from Jeffco Government Center Station to Union Station Track 11\r\n4:55 pm from Jeffco Government Center Station to Union Station Track 11"
