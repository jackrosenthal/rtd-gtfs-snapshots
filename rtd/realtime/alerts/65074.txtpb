cause: MAINTENANCE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "D Line notice: from Tue Aug 12 through Thu Aug 14 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD will perform necessary maintenance affecting a portion of D Line light rail service beginning Tuesday, Aug. 12 through Thursday, Aug. 14. Crews will replace overhead wires that provide power to the light rail trains.\r\n\nBus shuttles will replace D Line service between Littleton•Mineral and Evans stations. Customers should anticipate longer travel times during the wire replacement. Work is weather dependent.\r\n\nBoarding for bus shuttles will take place at the following station locations:\r\n\n    Littleton•Mineral Station: Gate A\r\n    Littleton•Downtown Station: Gates on Prince Street (Gate F-southbound; Gate B-northbound)\r\n    Oxford•City of Sheridan Station: Bus bridge gate\r\n    Englewood Station: Gate E\r\n    Evans Station – Gate C\r\n\nDuring the work, trains will operate scheduled service north of Evans Station. Full service on the D Line will resume Friday, Aug. 15.\r\n\nCustomers affected by the temporary rail disruption are encouraged to use RTD’s Next Ride web app to plan their trip.\r\n\nRTD appreciates customers’ patience as the agency works to make lives better through connections.\r\n\nAffected stops:\r\nLittleton / Mineral Station\r\nLittleton / Downtown Station\r\nOxford-City of Sheridan Station\r\nEnglewood Station\r\nEvans Station"
    language: "en"
  }
}
