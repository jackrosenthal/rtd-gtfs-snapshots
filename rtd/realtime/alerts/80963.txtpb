description_text {
  translation {
    text: "Bus shuttles will be replacing the Westbound A Line Saturday, July 25 at Denver Airport, 61st-Pena, and 40th and Airport-Gateway Park Stations.\r\nBus shuttle boarding locations are as follows:  \r\nDenver Airport Station: Arrivals at Gate 6; Departures at Gate 7 \r\nLocated at the DEN Transit Center, Level 1, adjacent to the Westin Denver International Airport Hotel. The DEN Transit Center can be accessed at the south end of Jeppesen Terminal by exiting through the glass doors and taking the escalator or elevator down to ground level. \r\n61st-Pena Station: In front of the station \r\n40th & Airport-Gateway Park Station: Gate A"
    language: "en"
  }
}
