  translation {
    text: "Affected northbound trips:\r\n8:46 am from Evans Station to 16th Street & California St Station\r\n9:41 am from Littleton / Mineral Ave Station to 18th & California Station\r\n11:26 am from Littleton / Mineral Ave Station to 18th & California Station\r\n1:11 pm from Littleton / Mineral Ave Station to 18th & California Station\r\n2:56 pm from Littleton / Mineral Ave Station to 18th & California Station\r\n4:41 pm from Littleton / Mineral Ave Station to 18th & California Station\r\n\nAffected southbound trips:\r\n8:57 am from Englewood Station to Littleton / Mineral Ave Station\r\n10:18 am from 18th & Stout Station to Littleton / Mineral Ave Station\r\n12:03 pm from 18th & Stout Station to Littleton / Mineral Ave Station\r\n1:48 pm from 18th & Stout Station to Littleton / Mineral Ave Station\r\n3:33 pm from 18th & Stout Station to Littleton / Mineral Ave Station\r\n5:18 pm from 18th & Stout Station to Littleton / Mineral Ave Station"
