  translation {
    text: "Affected stops:\r\nS Monaco Pkwy & Florida Ave (#15535) (northbound)\r\nS Monaco Pkwy & Cherry Crk Dr (#15526) (northbound)\r\nS Monaco Pkwy & Arizona Ave (#15517) (northbound)\r\nS Monaco Pkwy & Mississippi Ave (#15558) (southbound)\r\nS Monaco Pkwy & Arizona Ave (#15516) (southbound)\r\nS Monaco Pkwy & Cherry Crk Dr (#19014) (southbound)\r\n\nFor northbound Route 65 get on/off buses at:\r\nS Monaco Pkwy & Mexico Ave (#15555)\r\nS Monaco Pkwy & Mississippi Ave (#15557)\r\n\nFor southbound Route 65 get on/off buses at:\r\nS Monaco Pkwy & Kentucky Ave (#15547)\r\nS Monaco Pkwy & Florida Ave (#15536)"
    language: "en"
  }
}
