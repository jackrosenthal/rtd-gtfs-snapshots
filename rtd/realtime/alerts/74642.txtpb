header_text {
  translation {
    text: "NB1 and NB2 trips experiencing greater than 60 minute delays today due to road closure."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips on NB1:\r\n2:50 pm from Downtown Boulder Station Gate 4\r\n3:25 pm from Downtown Boulder Station Gate 4\r\n4:10 pm from Downtown Boulder Station Gate 4\r\n\nAffected eastbound trips on NB1:\r\n2:51 pm from Eldora Mountain Resort\r\n3:51 pm from Eldora Mountain Resort\r\n4:30 pm from Eldora Mountain Resort\r\n5:11 pm from Eldora Mountain Resort\r\n\nAffected westbound trips on NB2:\r\n5:25 pm from Downtown Boulder Station Gate 4\r\n6:25 pm from Downtown Boulder Station Gate 4\r\n7:25 pm from Downtown Boulder Station Gate 4\r\n\nAffected eastbound trips on NB2:\r\n6:12 pm from Nederland High School\r\n7:22 pm from Nederland High School"
    language: "en"
  }
}
