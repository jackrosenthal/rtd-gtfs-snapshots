  translation {
    text: "Affected southbound trips:\r\n2:40 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n4:55 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n7:25 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n9:55 pm from Union Station Track 12 to Ridgegate Parkway Station\r\n\nAffected northbound trips:\r\n3:54 pm from Ridgegate Parkway Station to Union Station Track 11\r\n6:09 pm from Ridgegate Parkway Station to Union Station Track 11\r\n8:39 pm from Ridgegate Parkway Station to Union Station Track 11\r\n11:09 pm from Ridgegate Parkway Station to Union Station Track 11"
    language: "en"
  }
}
