  translation {
    text: "Change\r\nRoute 83L will be extended to serve Union Station from Wade Blank Civic Center Station via 15th and 17th streets.\r\n\nReason\r\nRequested by policymakers, stakeholders and customers.\r\n\nSurvey Results\r\nOut of 35 respondents, 89% reported a positive impact from the change, 6% indicated it had no impact, and 6% perceived the change negatively."
    language: "en"
  }
}
