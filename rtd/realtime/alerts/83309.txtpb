header_text {
  translation {
    text: "JUMP service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute will also serve paratransit customers at Gate J at Downtown Boulder Station, while Gate M will remain departure gate.\r\n\nReason\r\nImprove safety and accessibility by providing safer bus turn movements and dedicated access to Gate J for paratransit customers who have difficulty crossing Canyon Street, while aligning service levels with seasonal demand.\r\n\nSurvey Results\r\nOut of 29 respondents, 45% reported a positive impact from the change, 48% indicated it had no impact, and 6% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
