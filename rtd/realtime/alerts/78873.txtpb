header_text {
  translation {
    text: "Route 112 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nThe following low-ridership, evening trips on weekdays and weekends will be discontinued: Weekday: 7:05 p.m. eastbound and 7:31 p.m. westbound (average 6 boardings) Saturday: 6:05 p.m. and 7:05 p.m. eastbound and 6:29 p.m. and 7:25 p.m. westbound (average 12 boardings) Sunday: 6:06 p.m. eastbound and 5:35 p.m. westbound (average 9 boardings)\r\n\nReason\r\nVery low utilization makes these trips inefficient.\r\n\nSurvey Results\r\nOut of 10 respondents, 10% reported a positive impact from the change, 60% indicated it had no impact, and 30% perceived the change negatively."
    language: "en"
  }
}
