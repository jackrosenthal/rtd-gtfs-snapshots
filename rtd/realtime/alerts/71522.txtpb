  translation {
    text: "Affected northbound trips:\r\n4:10 pm from Ridgegate Parkway Station\r\n5:25 pm from Ridgegate Parkway Station\r\n6:40 pm from Ridgegate Parkway Station\r\n8:10 pm from Ridgegate Parkway Station\r\n9:40 pm from Ridgegate Parkway Station\r\n11:10 pm from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n4:42 pm from Southmoor Station\r\n5:57 pm from Southmoor Station\r\n7:27 pm from Southmoor Station\r\n8:57 pm from Southmoor Station\r\n10:27 pm from Southmoor Station\r\n11:57 pm from Southmoor Station"
