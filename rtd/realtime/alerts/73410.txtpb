cause: MAINTENANCE
effect: DETOUR
header_text {
  translation {
    text: "Shuttle buses replacing N Line southbound from Sat Jan 31 through Sun Feb 1 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "N Line: RTD will provide bus shuttle service for N Line customers between Union Station and 48th & Brighton-National Western Center Station.\r\n\n    N Line customers at Union Station can access the shuttle at Gate B22 in the underground bus concourse\r\n    At 48th& Brighton-National Western Center Station, customers can access shuttle service at the bus stop at the station\r\n    N Line service will operate as normal between 48th& Brighton-National Western Center Station and Eastlake-124th Station\r\n\nAffected stops:\r\n48th & Brighton-National Western Station Track 1 (#35246)\r\nUnion Station Track 2 (#34668)"
    language: "en"
  }
}
