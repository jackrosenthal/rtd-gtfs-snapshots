effect: DETOUR
header_text {
  translation {
    text: "FreeRide detoured from Sat May 9 to Sat Dec 12 every 2nd Saturday from 8:00 AM to 10:00 PM due to special event."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected stops:\r\n16th Street & Arapahoe St (#22353) (civic ctr)\r\n16th Street & Curtis St (#22354) (civic ctr)\r\n16th Street & Champa St (#22355) (civic ctr)\r\n16th Street & Stout St (#22356) (civic ctr)\r\n16th Street & California St (#22357) (civic ctr)\r\n16th Street & Welton St (#22358) (civic ctr)\r\n16th Street & Glenarm Pl (#22359) (civic ctr)\r\n16th Street & Tremont Pl (#22360) (civic ctr)\r\n16th Street & Glenarm Pl (#22365) (union stn)\r\n16th Street & Welton St (#22366) (union stn)\r\n16th Street & California St (#22367) (union stn)\r\n16th Street & Stout St (#22368) (union stn)\r\n16th Street & Champa St (#22369) (union stn)\r\n16th Street & Curtis St (#22370) (union stn)\r\n16th Street & Arapahoe St (#22371) (union stn)\r\n16th Street & Lawrence St (#22372) (union stn)\r\n\nFor Civic Ctr FreeRide get on/off buses at:\r\n16th Street & Lawrence St (#22352)\r\n16th Street & Court Pl (#22361)\r\n\nFor Union Stn FreeRide get on/off buses at:\r\n16th Street & Tremont Pl (#22364)\r\n16th Street & Larimer St (#22373)"
    language: "en"
  }
}
