  translation {
    text: "Affected northbound trips:\r\n10:52 am from Littleton / Mineral Ave Station\r\n12:22 pm from Littleton / Mineral Ave Station\r\n1:52 pm from Littleton / Mineral Ave Station\r\n3:22 pm from Littleton / Mineral Ave Station\r\n4:51 pm from Littleton / Mineral Ave Station\r\n6:22 pm from Littleton / Mineral Ave Station\r\n\nAffected southbound trips:\r\n11:34 am from Union Station Track 12\r\n1:04 pm from Union Station Track 12\r\n2:34 pm from Union Station Track 12\r\n4:04 pm from Union Station Track 12\r\n5:33 pm from Union Station Track 12"
    language: "en"
  }
}
