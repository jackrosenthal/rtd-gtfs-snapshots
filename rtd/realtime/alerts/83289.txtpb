header_text {
  translation {
    text: "Route 51 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nReinstate seasonal tripper service while adding both a morning and evening trip to alleviate overcrowding caused by school bell times at John F. Kennedy High School. Trips added are a Southbound 8:05am trip starting at W Dartmouth Ave & S Lamar St (Stop ID: 13281) and a Northbound 4:05pm trip starting at W Dartmouth Ave & S Lamar St (Stop ID: 13282).\r\n\nReason\r\nAlleviate overcrowding per school bell times at John F. Kennedy High School.\r\n\nSurvey Results\r\nOut of 17 respondents, 71% reported a positive impact from the change, 29% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
