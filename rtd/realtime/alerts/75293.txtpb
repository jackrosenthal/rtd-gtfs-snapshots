  translation {
    text: "Affected stops:\r\n22nd St & Larimer St (#23221) (eastbound)\r\nLarimer St & 21st St (#20522) (eastbound)\r\nLarimer St & 19th St (#17750) (eastbound)\r\nLawrence St & 16th Street (#17752) (westbound)\r\nLawrence St & 18th St (#17753) (westbound)\r\nLawrence St & 20th St (#23222) (westbound)\r\nPark Ave West & Lawrence St (#23223) (westbound)\r\nPark Ave West & Blake St (#23224) (westbound)\r\n\nFor eastbound Route 38 get on/off buses at:\r\nPark Ave West & Wewatta St (#23955)\r\n17th St & Lawrence St (#17717)\r\n\nFor westbound Route 38 get on/off buses at:\r\nPark Ave W & Delgany St (#23956)"
    language: "en"
  }
