header_text {
  translation {
    text: "Route 15 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nBus-Only Lane Operations (BOLO) will be implemented along Colfax Avenue between Broadway and Colorado Blvd., and western segment of route that serves Decatur•Federal station will be discontinued. \r\n\nNote: Starting September 27, 15 and 15L buses will use new center bus-only lanes between Broadway and Colorado Blvd. Customers will board and exit at the new stations in the center of Colfax Avenue, current stops along the sidewalks of Colfax Avenue will be removed and not serviced by either route. \r\n\nReason\r\nSupport East Colfax Bus-Only Lane Operations (BOLO) per progression of Bus Rapid Transit Project.\r\n\nSurvey Results\r\nOut of 64 respondents, 64% reported a positive impact from the change, 13% indicated it had no impact, and 21% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
