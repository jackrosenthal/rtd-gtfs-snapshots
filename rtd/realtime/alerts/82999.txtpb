header_text {
  translation {
    text: "Shuttle buses replacing A Line westbound from 5:30 AM to 11:30 AM on Sun Sep 13 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD will conduct essential maintenance on the A Line on Sunday, Sept. 13, from approximately 5:30 a.m.-11:30 a.m. between Denver Union and Central Park stations. Customers are advised to plan accordingly and allow additional travel time to connect to and from the airport.\r\n\nBoard bus shuttles at the following locations: \r\nUnion Station (underground bus concourse): Gate B22\r\n38th-Blake: In front of station\r\n40th-Colorado: Gate B\r\nCentral Park: Gate B3"
    language: "en"
  }
}
severity_level: SEVERE
