header_text {
  translation {
    text: "AB2 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nProvide hourly AB2 service to and from Boulder Junction on weekdays, beginning with the 5:30 a.m. eastbound trip and ending with the 7:00 p.m. westbound trip. On Saturdays and Sundays, provide hourly service beginning with the 4:30 a.m. eastbound trip and ending with the 4:43 p.m. westbound trip. Combined with AB1 service, these changes would provide 20-minute frequency at Table Mesa Station for most of the day on weekdays and 30-minute frequency on weekends.\r\n\nReason\r\nProvide more frequent service between Boulder and Denver International Airport to better align service with customer demand, subject to available space at DEN."
    language: "en"
  }
}
severity_level: WARNING
