description_text {
  translation {
    text: "Route LX will be reinstated, with three (3) southbound trips and two (2) northbound trips during the morning peak (7:00–8:30 a.m.), and two (2) southbound trips and three (3) northbound trips during the afternoon peak (4:00–5:30 p.m.). Start and end terminal of the route in Longmont will be at Coffman & 8th Ave PnR in order to keep MCI vehicles off Gay Street per neighborhoods request"
    language: "en"
  }
}
