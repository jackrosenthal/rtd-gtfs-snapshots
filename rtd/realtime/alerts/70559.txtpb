header_text {
  translation {
    text: "E Line southbound service suspended due to traffic accident."
    language: "en"
  }
}
description_text {
  translation {
    text: "E line service between Broadway Station to Union Station has been suspended , please use D line trains south to Broadway Station and transfer to bus shuttles to continue southbound to Belleview Station. Normal train service between Belleview Station and Ridgegate Station. \r\n\nAffected stops:\r\nUnion Station Track 12 (#25434)\r\nEvans Station (#25435)\r\nBall Arena / Elitch Gardens Station (#25433)\r\nEmpower Field at Mile High Station (#25432)\r\nAuraria West Station (#25431)\r\n10th & Osage Station (#23059)\r\nAlameda Station (#23060)"
    language: "en"
  }
}
