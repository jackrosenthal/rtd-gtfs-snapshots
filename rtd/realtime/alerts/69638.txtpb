cause: POLICE_ACTIVITY
effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 8:12 am from Denver Airport Station and 11 other trips cancelled today due to police activity. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected westbound trips:\r\n8:12 am from Denver Airport Station\r\n8:42 am from Denver Airport Station\r\n9:12 am from Denver Airport Station\r\n9:42 am from Denver Airport Station\r\n10:12 am from Denver Airport Station\r\n10:42 am from Denver Airport Station\r\n\nAffected eastbound trips:\r\n8:15 am from Union Station Track 1\r\n8:45 am from Union Station Track 1\r\n9:15 am from Union Station Track 1\r\n9:45 am from Union Station Track 1\r\n10:15 am from Union Station Track 1\r\n10:45 am from Union Station Track 1"
    language: "en"
  }
}
