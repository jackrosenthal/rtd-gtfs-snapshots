description_text {
  translation {
    text: "Affected stops:\r\nW Colfax Ave & Elati St (#23216) (eastbound)\r\nW Colfax Ave & Bannock St (#23217) (eastbound)\r\nColfax Ave & Broadway (#12849) (eastbound)\r\nColfax Ave & Sherman St (#12978) (eastbound)\r\nGrant St & 14th Ave (#18999) (eastbound)\r\nColfax Ave & Broadway (#12850) (westbound)\r\nW Colfax Ave & 14th St (#23215) (westbound)\r\nW Colfax Ave & Tremont Pl (#33989) (westbound)\r\n\nFor eastbound Route 16 get on/off buses at:\r\nW Colfax Ave & Mariposa St (#18863)\r\nBuses will drop off/layover at the far side of Colfax Ave on Lincoln St\r\n\nFor westbound Route 16 get on/off buses at:\r\nBroadway & W Colfax Ave nearside (#17731)\r\nW Colfax Ave & Lipan St (#18982)"
    language: "en"
  }
}
