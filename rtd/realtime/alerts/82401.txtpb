description_text {
  translation {
    text: "Affected stops:\r\nYale Ave & S Monaco Pkwy (#17344) (northbound)\r\nYale Ave & S Krameria St (#17333) (northbound)\r\nYale Ave & S Holly St (#17321) (northbound)\r\nYale Ave & S Hudson St (#17325) (northbound)\r\nYale Ave & S Hudson St (#17324) (southbound)\r\nYale Ave & S Jersey St (#17329) (southbound)\r\nYale Ave & S Locust St (#17332) (southbound)\r\n\nFor northbound Route 46 get on/off buses at:\r\nYale Ave & S Norman Ct (#17347)\r\nYale Station Gate A (#26132)\r\n\nFor southbound Route 46 get on/off buses at:\r\nYale Ave & S Forest St (#17315)\r\nYale Ave & S Monaco Pkwy (#17343)"
    language: "en"
  }
}
severity_level: SEVERE
