header_text {
  translation {
    text: "Planned schedule change on D Line beginning Sun Aug 31."
    language: "en"
  }
}
description_text {
  translation {
    text: "D Line trains rerouted to Denver Union Station beginning August 31. D Line customers can connect between Denver Union Station and Civic Center Station using the 16th Street Free Mall Ride or Free MetroRide.\r\n \r\nThe next phase of light rail track reconstruction work in downtown Denver begins on September 2. This phase will involve reconstructing the light rail crossing on Kalamath Street between Colfax Ave and Speer Blvd. No light rail service will operate between 10th and Osage and 18th and California Stations, or between 30th and Downing and 16th and Stout Stations."
    language: "en"
  }
}
