cause: CONSTRUCTION
effect: NO_SERVICE
header_text {
  translation {
    text: "C Line Trip 8:48 pm from Union Station Track 12 and 17 other trips will have modified service on Sat Jul 11 due to construction. Check trip status using NextRide, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Bus shuttles will run between Broadway Station and Englewood Station for the listed trips.\r\n\nShuttle locations:\r\nEnglewood Station: Gate A\r\nEvans Station: Gate C\r\nI-25-Broadway Station: Gate A3\r\n\nAffected southbound trips:\r\n8:48 pm from Union Station Track 12\r\n9:48 pm from Union Station Track 12\r\n10:18 pm from Union Station Track 12\r\n10:48 pm from Union Station Track 12\r\n11:18 pm from Union Station Track 12\r\n12:18 am from Union Station Track 12\r\n12:48 am from Union Station Track 12\r\n1:18 am from Union Station Track 12\r\n1:48 am from Union Station Track 12\r\n\nAffected northbound trips:\r\n8:52 pm from Littleton / Mineral Ave Station\r\n9:22 pm from Littleton / Mineral Ave Station\r\n9:52 pm from Littleton / Mineral Ave Station\r\n10:22 pm from Littleton / Mineral Ave Station\r\n10:52 pm from Littleton / Mineral Ave Station\r\n11:22 pm from Littleton / Mineral Ave Station\r\n11:52 pm from Littleton / Mineral Ave Station\r\n12:22 am from Littleton / Mineral Ave Station\r\n12:52 am from Littleton / Mineral Ave Station"
    language: "en"
  }
}
