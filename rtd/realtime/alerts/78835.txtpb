header_text {
  translation {
    text: "Route 0L service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nExtend hours of operation, adding weekday midday service between I-25•Broadway Station and Wade Blank Civic Center Station.\r\n\nReason\r\nProvide additional mobility and connections for customers affected by central corridor rail service being diverted to Denver Union Station during final phases of the Downtown Rail Reconstruction Project.\r\n\nSurvey Results\r\nOut of 46 respondents, 85% reported a positive impact from the change, 13% indicated it had no impact, and 2% perceived the change negatively."
    language: "en"
  }
}
