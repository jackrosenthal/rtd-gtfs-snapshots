url {
  translation {
    text: "https://www.rtd-denver.com/community/news/2026/surface-parking-lot-at-rtd-arapahoe-at-village-center-station-to-close-nov-9-as-greenwood-village-begins-park-conversion"
    language: "en"
  }
}
header_text {
  translation {
    text: "Change at Arapahoe at Village Center Station beginning Mon Nov 9. "
    language: "en"
  }
}
description_text {
  translation {
    text: "The surface parking lot at Arapahoe at Village Center Station will close Nov. 9 as the city of Greenwood Village begins transforming the city-owned lot into a new park featuring pickleball courts.\r\n\nRTD access will remain fully available. Customers can continue to use all RTD facilities, including the Park-n-Ride garage, bus terminals, pedestrian walkway and bridge, and light rail services. Access from the parking garage to the pedestrian pathway over I-25 and to the light rail platform will not be affected during construction."
    language: "en"
  }
}
severity_level: WARNING
