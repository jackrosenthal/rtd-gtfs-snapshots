cause: CONSTRUCTION
effect: DETOUR
header_text {
  translation {
    text: "JUMP detoured on Sun Oct 26 until 7:00 PM due to construction."
    language: "en"
  }
}
description_text {
  translation {
    text: "Rolling detours between Foothills Pkwy & Cherryvale Road, when road is blocked stops will be unavailable. \r\n\nAffected direction: Eastbound\r\n\nAffected stops:\r\nArapahoe Ave & Foothills Pkwy Nearside (#19189)\r\nArapahoe Ave & Foothills Pkwy Farside (#33165)\r\nArapahoe Ave & MacArthur Dr (#12238)\r\nArapahoe Ave & 48th St (#12219)\r\nArapahoe Ave & Eisenhower Dr (#12235)\r\nArapahoe Ave & Conestoga St (#19387)\r\nConestoga St & Arapahoe Ave (#19698)\r\nArapahoe Ave & 55th St (#12221)\r\n5700 Block Arapahoe Ave (#12236)\r\nArapahoe Ave & Old Tale Rd (#12244)\r\n\nAvailable alternate stops:\r\nArapahoe Ave & Marine St (#12241)\r\nArapahoe Ave & Cherryvale Rd (#12232)"
    language: "en"
  }
}
