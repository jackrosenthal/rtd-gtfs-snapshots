cause: UNKNOWN_CAUSE
effect: NO_SERVICE
header_text {
  translation {
    text: "Due to a non-RTD related accident near Yale Station, E Line is operating on a modified schedule today."
    language: "en"
  }
}
description_text {
  translation {
    text: "Between Ridgegate Parkway and Southmoor Stations, E Line trains are operating every 15-minutes.\r\n\nBetween Southmoor Station and Denver Union Station, E Line trains are operating every 30-minutes.\r\n\nCustomers needing to travel beyond Southmoor Station will need to transfer to a different E Line train at Southmoor Station."
    language: "en"
  }
}
