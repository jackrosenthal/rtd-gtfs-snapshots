description_text {
  translation {
    text: "Affected southbound trips:\r\n9:45 am from 18th & Stout Station to Florida Station\r\n11:45 am from 18th & Stout Station to Florida Station\r\n1:45 pm from 18th & Stout Station to Florida Station\r\n3:45 pm from 18th & Stout Station to Florida Station\r\n5:45 pm from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n10:54 am from Florida Station to 18th & California Station\r\n12:54 pm from Florida Station to 18th & California Station\r\n2:54 pm from Florida Station to 18th & California Station\r\n4:54 pm from Florida Station to 18th & California Station"
    language: "en"
  }
}
