cause: UNKNOWN_CAUSE
header_text {
  translation {
    text: "Route 10 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Change service pattern to operate via 9th-Clermont every 20 minutes both eastbound and westbound between approximately 6:00 a.m. and 6:30 p.m. instead of the current 30-minute midday and 15-minute peak period peak direction service. Hourly trips to Aurora and Colfax & Billings would remain in place.\r\n\nReason: Changes would allow for an additional 11 new trips on Route 10 in support of the service expansion.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
