header_text {
  translation {
    text: "Route 21 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nExisting Route 21 will split, and increase service to every 15 minutes on the East Evans segment between Evans Station and Aurora Metro Center Station.\r\n\nReason\r\nImproves service reliability and increases frequency on the higher-ridership eastern portion of the route.\r\n\nSurvey Results\r\nOut of 31 respondents, 84% reported a positive impact from the change, 6% indicated it had no impact, and 9% perceived the change negatively."
    language: "en"
  }
}
