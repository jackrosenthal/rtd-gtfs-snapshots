  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n6:30 am from Evans Station\r\n8:04 am from I-25 & Broadway Station\r\n9:34 am from I-25 & Broadway Station\r\n11:04 am from I-25 & Broadway Station\r\n12:34 pm from I-25 & Broadway Station\r\n2:04 pm from I-25 & Broadway Station\r\n\nAffected southbound trips:\r\n7:16 am from 30th & Downing Station\r\n8:46 am from 30th & Downing Station\r\n10:16 am from 30th & Downing Station\r\n11:46 am from 30th & Downing Station\r\n1:16 pm from 30th & Downing Station\r\n2:46 pm from 30th & Downing Station"
    language: "en"
  }
}
