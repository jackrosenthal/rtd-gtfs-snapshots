  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n11:30 pm from Union Station Track 1 to Denver Airport Station\r\n12:00 am from Union Station Track 1 to Denver Airport Station\r\n12:30 am from Union Station Track 1 to Denver Airport Station\r\n\nAffected stops:\r\n40th & Colorado Station Track 1 (#34467)\r\nCentral Park Station Track 1 (#34469)\r\nPeoria Station Track 1 (#34471)\r\n40th Ave & Airport Blvd - Gateway Park Station Track 1 (#34473)\r\n61st & Pena Station Track 1 (#34605)\r\nDenver Airport Station (#34475)"
    language: "en"
  }
}
