  translation {
    text: "Affected stops:\r\nCoffman St & 4th Ave (#35562) (northbound)\r\nCoffman St & 6th Ave (#35564) (northbound)\r\n8th & Coffman PnR Gate F (#35567) (northbound)\r\n8th & Coffman PnR Gate C (#17798) (southbound)\r\nCoffman St & 6th Ave (#35563) (southbound)\r\nCoffman St & 4th Ave (#35561) (southbound)\r\n\nBuses will service stops at Main St & 8th Ave. \r\n\nFor northbound Route 324 get on/off buses at:\r\nMain St & 1st Ave (#15146)\r\nMain St & 9th Ave (#15159)\r\n\nFor southbound Route 324 get on/off buses at:\r\nMain St & 11th Ave (#15142)\r\nS Main St & 1st Ave (#25633)"
    language: "en"
  }
}
