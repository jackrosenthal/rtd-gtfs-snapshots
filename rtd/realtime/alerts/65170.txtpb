description_text {
  translation {
    text: "Affected northbound trips:\r\n4:16 am from Evans Station to Union Station Track 11\r\n6:09 am from Ridgegate Parkway Station to Union Station Track 11\r\n8:24 am from Ridgegate Parkway Station to Union Station Track 11\r\n10:39 am from Ridgegate Parkway Station to Union Station Track 11\r\n12:54 pm from Ridgegate Parkway Station to Union Station Track 11\r\n\nAffected southbound trips:\r\n5:01 am from Union Station Track 12 to Ridgegate Parkway Station\r\n7:10 am from Union Station Track 12 to Ridgegate Parkway Station\r\n9:25 am from Union Station Track 12 to Ridgegate Parkway Station\r\n11:40 am from Union Station Track 12 to Ridgegate Parkway Station"
    language: "en"
  }
}
