cause: TECHNICAL_PROBLEM
effect: NO_SERVICE
header_text {
  translation {
    text: "A Line Trip 4:15 pm from Union Station Track 1 and 10 other trips cancelled today due to switch problem. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n4:15 pm from Union Station Track 1\r\n4:45 pm from Union Station Track 1\r\n5:15 pm from Union Station Track 1\r\n5:45 pm from Union Station Track 1\r\n6:15 pm from Union Station Track 1\r\n\nAffected westbound trips:\r\n4:42 pm from Denver Airport Station\r\n5:12 pm from Denver Airport Station\r\n5:42 pm from Denver Airport Station\r\n6:12 pm from Denver Airport Station\r\n6:42 pm from Denver Airport Station\r\n7:12 pm from Denver Airport Station"
    language: "en"
  }
}
