description_text {
  translation {
    text: "Change\r\nThe following weekday trips will be discontinued: Westbound: 7:45 p.m. (average 2 boardings) Eastbound: 8:00 p.m. (average 3 boardings)\r\n\nReason\r\nVery low utilization makes these trips inefficient.\r\n\nSurvey Results\r\nOut of 11 respondents, 9% reported a positive impact from the change, 45% indicated it had no impact, and 45% perceived the change negatively."
    language: "en"
  }
}
