  translation {
    text: "Change\r\nMinor changes to weekday, Saturday and Sunday/Holiday schedules, and suspension of seasonal tripper service.\r\n\nReason\r\nImprove on-time performance and service reliability while aligning with seasonal ridership levels.\r\n\nSurvey Results\r\nOut of 30 respondents, 30% reported a positive impact from the change, 53% indicated it had no impact, and 16% perceived the change negatively."
    language: "en"
  }
