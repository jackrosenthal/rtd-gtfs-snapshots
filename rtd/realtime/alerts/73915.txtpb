    text: "Affected eastbound trips:\r\n6:24 pm from Jeffco Government Center Station\r\n8:24 pm from Jeffco Government Center Station\r\n10:24 pm from Jeffco Government Center Station\r\n12:24 am from Jeffco Government Center Station\r\n\nAffected westbound trips:\r\n7:23 pm from Union Station Track 12\r\n9:23 pm from Union Station Track 12\r\n11:23 pm from Union Station Track 12\r\n1:23 am from Union Station Track 12"
    language: "en"
  }
}
