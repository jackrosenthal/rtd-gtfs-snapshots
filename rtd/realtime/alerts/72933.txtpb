  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n5:56 pm from Union Station Track 12\r\n\nAffected northbound trips:\r\n7:10 pm from Ridgegate Parkway Station\r\n\nAffected stops:\r\nUniversity of Denver Station\r\nLouisiana / Pearl Station\r\nI-25 / Broadway Station\r\nAlameda Station\r\n10th / Osage Station\r\nAuraria West Campus Station\r\nEmpower Field at Mile High\r\nBall Arena / Elitch Gardens Station\r\nUnion Station\r\n\n"
    language: "en"
  }
}
