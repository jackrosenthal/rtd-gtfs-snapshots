  translation {
    text: "Affected direction: Westbound\r\n\nAffected westbound trips:\r\n11:12 am from Denver Airport Station\r\n11:42 am from Denver Airport Station\r\n12:12 pm from Denver Airport Station\r\n12:42 pm from Denver Airport Station\r\n1:12 pm from Denver Airport Station\r\n1:42 pm from Denver Airport Station\r\n2:12 pm from Denver Airport Station\r\n2:42 pm from Denver Airport Station\r\n3:12 pm from Denver Airport Station\r\n3:42 pm from Denver Airport Station\r\n4:12 pm from Denver Airport Station\r\n4:42 pm from Denver Airport Station\r\n5:12 pm from Denver Airport Station\r\n5:42 pm from Denver Airport Station\r\n6:12 pm from Denver Airport Station\r\n6:42 pm from Denver Airport Station\r\n7:12 pm from Denver Airport Station"
