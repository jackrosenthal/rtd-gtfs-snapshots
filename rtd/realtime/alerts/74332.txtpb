cause: UNKNOWN_CAUSE
header_text {
  translation {
    text: "Route 112 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "It is proposed to discontinue the following low-ridership trips in evenings on weekdays and weekends: Weekday: 7:05 p.m. eastbound and 7:31 p.m. westbound (average 6 boardings) Saturday: 6:05 p.m. and 7:05 p.m. eastbound and 6:29 p.m. and 7:25 p.m. westbound (average 12 boardings) Sunday: 6:06 p.m. eastbound and 5:35 p.m. westbound (average 9 boardings)\r\n\nReason: Very low utilization makes these trips inefficient.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
