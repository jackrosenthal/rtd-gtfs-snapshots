header_text {
  translation {
    text: "G Line service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRestore 15-minute service frequency on weekdays from 6:00 a.m.–9:00 p.m., and Saturdays and Sundays/Holidays from 8:00 a.m.–6:00 p.m.\r\n\nReason\r\nProvide additional service to better match demand and improve reliability during the busiest travel periods.\r\n\nSurvey Results\r\nOut of 213 respondents, 96% reported a positive impact from the change, 2% indicated it had no impact, and 2% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject"
    language: "en"
  }
}
