cause: MAINTENANCE
effect: DETOUR
header_text {
  translation {
    text: "Shuttle buses replacing W Line westbound from Sat Apr 11 through Mon Apr 13 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "W Lines will be replaced with bus shuttles between Auraria West Station and Union Station (the bus shuttles will include 10th-Osage Station to accommodate transfers to and from the E Line). W Line customers can board shuttle buses at the following locations:\r\n\n10th-Osage Station: bus bridge gate on Osage Street\r\nEmpower Field at Mile High and Auraria West stations: bus bridge sign at 5th and Larimer streets\r\nBall Arena-Elitch Gardens Station: bus bridge sign at station (Chopper Circle roundabout)\r\nUnion Station: Gate B22 (underground bus concourse)"
    language: "en"
  }
}
