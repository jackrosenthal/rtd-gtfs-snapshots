  translation {
    text: "Change\r\nMinor changes to weekday, Saturday, and Sunday/Holiday schedules.\r\n\nReason\r\nImproves on-time performance while accommodating suspension of the D Line.\r\n\nSurvey Results\r\nOut of 115 respondents, 43% reported a positive impact from the change, 33% indicated it had no impact, and 24% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject\r\n"
    language: "en"
  }
