header_text {
  translation {
    text: "Route 46 detoured daily from 8:30 AM - 3:30 PM Mon Jun 29 to Fri Jul 17 due to milling and paving operation along Yale Ave between Monaco Pkwy and Quebec St. "
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected stops:\r\nYale Ave & S Quebec St (#19305) (northbound)\r\nYale Ave & S Oneida St (#17352) (northbound)\r\nYale Ave & S Norman Ct (#17347) (northbound)\r\nYale Ave & S Monaco Pkwy (#17343) (southbound)\r\nYale Ave & S Norman Ct (#17348) (southbound)\r\nYale Ave & S Oneida St (#17351) (southbound)\r\n\nFor northbound Route 46 get on/off buses at:\r\nS Quebec St & Amherst Ave (#16145)\r\nYale Ave & S Monaco Pkwy (#17344)\r\n\nFor southbound Route 46 get on/off buses at:\r\nYale Ave & S Locust St (#17332)\r\nS Quebec St & Yale Ave (#19304)"
    language: "en"
  }
}
