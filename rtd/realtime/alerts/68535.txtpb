header_text {
  translation {
    text: "A Line and N Line notice: Track surfacing work will temporarily affect rail service on Saturday, October 18. Bus shuttles will support temporary suspensions of rail service during the work. "
    language: "en"
  }
}
description_text {
  translation {
    text: " A Line: Bus shuttles will provide service between Union Station and 38th-Blake Station beginning with the first departure from Union Station at 3 a.m. and lasting until approximately 3 p.m. Customers can board bus shuttles at the following station locations:\r\n\n        Union Station – Gate B-22\r\n        38th-Blake Station – bus bridge stop\r\n\n N Line: Bus shuttles will provide service between Union Station and 48th & Brighton-National Western Station beginning with the 6:04 a.m. departure from 48th & Brighton-National Western Station and lasting until approximately 3 p.m. Customers can board bus shuttles at the following station locations:\r\n\n        Union Station – Gate B-22\r\n        48th & Brighton-National Western Station – bus stop at station"
    language: "en"
  }
}
