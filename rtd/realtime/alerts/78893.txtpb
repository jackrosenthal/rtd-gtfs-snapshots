header_text {
  translation {
    text: "D Line service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nD Line will be suspended.\r\n\nReason\r\nFinal phases of the Downtown Rail Reconstruction Project will not allow for RTD to operate trains at Colfax at Auraria through the Downtown Loop. With the reinstatement of the C Line, D Line customers will have rail service to Union Station.\r\n\nSurvey Results\r\nOut of 272 respondents, 15% reported a positive impact from the change, 10% indicated it had no impact, and 74% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject\r\n"
    language: "en"
  }
}
