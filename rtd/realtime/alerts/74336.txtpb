cause: UNKNOWN_CAUSE
header_text {
  translation {
    text: "Route 228A Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "It is proposed to reduce operating hours on weekdays to 7:00 a.m.–9:00 p.m. and weekends to 8:00 a.m.–7:00 p.m., while discontinuing the following very low-ridership evening trips: Weekday: 9:07 p.m. northbound and 9:17 p.m. southbound (average 2.5 boardings) Saturday: 8:07 p.m. northbound and 8:13 p.m. southbound (average 2.5 boardings) Sunday: 8:07 p.m. northbound and 8:13 p.m. southbound: (average 3 boardings)\r\n\nReason: Very low utilization makes these trips inefficient.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
