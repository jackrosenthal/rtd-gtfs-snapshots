description_text {
  translation {
    text: "Change\r\nStraighten the westbound alignment to use Broadway and 15th Street and move inside Wade Blank Civic Center Station to Gate 2.\r\n\nReason\r\nImprove on-time performance and create a more direct, reliable route.\r\n\nSurvey Results\r\nOut of 18 respondents, 50% reported a positive impact from the change, 44% indicated it had no impact, and 6% perceived the change negatively."
    language: "en"
  }
}
