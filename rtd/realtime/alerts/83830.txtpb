}
description_text {
  translation {
    text: "Affected southbound trips:\r\n6:26 pm from Union Station Track 12\r\n\nAffected northbound trips:\r\n7:40 pm from Ridgegate Parkway Station\r\n\nAffected stops:\r\nRidgegate Parkway Station\r\nLone Tree City Center Station\r\nSky Ridge Station\r\nLincoln Station\r\nCounty Line Station\r\nDry Creek Station\r\nArapahoe at Village Center Station\r\nOrchard Station\r\nBelleview Station"
    language: "en"
  }
}
