header_text {
  translation {
    text: "R Line notice: beginning Sun Jan 4."
    language: "en"
  }
}
description_text {
  translation {
    text: " Beginning Sunday, Jan. 4, our latest service changes will take effect. RTD is making changes to enhance reliability and connectivity of services, improve on-time performance, and restore regular travel patterns to rail lines that were impacted by the most recent phase of the Downtown Rail Reconstruction Project, which concluded Nov. 25. RTD’s service changes aim to enhance the overall transit experience by improving reliability and on-time performance of bus and rail services.\r\n\nChange\r\nMinor changes to weekday, Saturday and Sunday/Holiday schedules.\r\n\nReason\r\nAccommodate the changes to the E and H line schedules per completion of project phases in the Downtown Rail Reconstruction Project.\r\n\nSurvey Results\r\nOut of 33 respondents, 36% reported a positive impact from the change, 30% indicated it had no impact, and 33% perceived the change negatively."
    language: "en"
  }
}
