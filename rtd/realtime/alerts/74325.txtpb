header_text {
  translation {
    text: "Route 44 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Straighten the westbound alignment to use Broadway and 15th Street and move inside Wade Blank Civic Center Station to Gate 2.\r\n\nReason: Improve on-time performance and create a more direct, reliable route.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
