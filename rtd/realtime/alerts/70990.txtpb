header_text {
  translation {
    text: "To supplement reduced E Line service north of Southmoor Station, express bus shuttles will be operating between Southmoor and I-25/Broadway Stations every 30-minutes on Saturday."
    language: "en"
  }
}
description_text {
  translation {
    text: "Shuttles will depart 15-minutes after scheduled E Line departures, which are also operating every 30-minutes between Southmoor Station and Denver Union Station. RTD is operating a special holiday service train (S Line) between I-25/Broadway and 30th/Downing Stations, which is operating every 15 minutes.\r\n\nBus shuttle boarding locations:\r\nSouthmoor Station: Gate A\r\nI-25/Broadway Station: Gate A3"
    language: "en"
  }
}
