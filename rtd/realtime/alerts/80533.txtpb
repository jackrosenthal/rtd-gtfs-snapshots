  translation {
    text: "Affected stops:\r\nS Sheridan Blvd & Morrison Rd (#16572) (eastbound)\r\nW Kentucky Ave & S Sheridan Blvd (#14769) (eastbound)\r\nW Kentucky Ave & S Vrain St (#14772) (eastbound)\r\nW Kentucky Ave & S Tennyson St (#19011) (eastbound)\r\nW Kentucky Ave & S Quitman St (#14764) (eastbound)\r\nW Kentucky Ave & S Quitman St (#14763) (westbound)\r\nW Kentucky Ave & S Tennyson St (#19012) (westbound)\r\nW Kentucky Ave & S Vrain St (#14773) (westbound)\r\nW Kentucky Ave & S Yates St (#19834) (westbound)\r\nS Sheridan Blvd & W Kentucky Ave (#16562) (westbound)\r\n\nFor eastbound Route 11 get on/off buses at:\r\nW Mississippi Ave & S Sheridan Blvd (#25363)\r\nW Kentucky Ave & S Osceola St (#14760)\r\n\nFor westbound Route 11 get on/off buses at:\r\nW Kentucky Ave & S Osceola St (#14759)\r\nW Mississippi Ave & S Sheridan Blvd (#15443)"
    language: "en"
  }
