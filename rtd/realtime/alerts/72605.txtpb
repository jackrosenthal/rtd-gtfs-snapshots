effect: DETOUR
header_text {
  translation {
    text: "FreeRide and 12 other routes detoured due to planned protest."
    language: "en"
  }
}
description_text {
  translation {
    text: "Due to crowd size, buses will not be entering the Union Station bus Concourse. Routes will bypass or hold at closest stop on route. \r\n\nAffected routes:\r\nFreeRide\r\nMetroRide\r\nFF1\r\nFF2\r\nFF3\r\nLD1\r\nLX2\r\n0\r\n9\r\n10\r\n15\r\n20\r\n120X\r\n\nAffected stops:\r\nUnion Station "
    language: "en"
  }
}
