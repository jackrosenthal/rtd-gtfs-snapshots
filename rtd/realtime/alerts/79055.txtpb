description_text {
  translation {
    text: "Included in the upcoming Service Change is the addition of the T (Temporary) line to supplement the suspension of the H line during the Downtown Rail Reconstruction Project. E line service alert subscribers have been added to the T line alerts as they serve similar stations between Broadway Station and Lincoln Station. \r\n\nIf you need to adjust your alert settings for these changes, please visit: https://notifications.rtd-denver.com/s\r\n\nFor additional information on the Downtown Rail Reconstruction Project and to keep up to date on the project, please visit the link below: "
    language: "en"
  }
}
