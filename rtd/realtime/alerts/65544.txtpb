description_text {
  translation {
    text: "Affected stops:\r\nArapahoe Community College (#11935) (eastbound)\r\nW Alamo Ave & S Prince St Gate G (#20424) (eastbound)\r\nW Littleton Blvd & S Spotswood St (#15018) (eastbound)\r\nW Littleton Blvd & S Windermere St (#15019) (eastbound)\r\nW Littleton Blvd & S Datura St (#15005) (eastbound)\r\nW Littleton Blvd & S Hickory St (#15010) (eastbound)\r\nW Littleton Blvd & S Fox St (#15009) (eastbound)\r\nW Littleton Blvd & S Fox St (#15008) (westbound)\r\nW Littleton Blvd & S Hickory St (#15011) (westbound)\r\nW Littleton Blvd & S Datura St (#15006) (westbound)\r\nW Littleton Blvd & S Windermere St (#15001) (westbound)\r\nW Littleton Blvd & S Spotswood St (#15016) (westbound)\r\nW Main St & S Rio Grande St (#15176) (westbound)\r\n\nFor eastbound Route 66 get on/off buses at:\r\nS Prince St & W Church Ave Gate E (#16081)\r\nW Littleton Blvd & S Cherokee St (#15002)\r\n\nFor westbound Route 66 get on/off buses at:\r\nW Littleton Blvd & S Cherokee St (#15004)\r\nS Prince St & W Alamo Ave Gate F (#24430)"
    language: "en"
  }
}
