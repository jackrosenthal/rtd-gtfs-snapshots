  translation {
    text: "Affected stops:\r\nBoulder Canyon Dr & E 3rd St (#18021) (eastbound)\r\nCO 119 & East St (#21917) (eastbound)\r\nCO 119 & Hurricane Hill Rd (#21918) (eastbound)\r\nCO 119 & Saint Anton (#21416) (eastbound)\r\nCO 119 & Boulder Falls (#21919) (eastbound)\r\nCO 119 & Mile Post 35 (#21920) (eastbound)\r\nCO 119 & Mile Post 36 (#22030) (eastbound)\r\nCO 119 & Magnolia Dr (#18023) (eastbound)\r\nCO 119 & Chapman Dr (#25783) (eastbound)\r\nCO 119 & Four Mile Canyon Rd (#20306) (eastbound)\r\nCanyon Blvd & 3rd St (#21897) (eastbound)\r\nCanyon Blvd & 6th St (#19026) (eastbound)\r\nCanyon Blvd & 9th St (#12669) (eastbound)\r\nCanyon Blvd & 11th St (#12662) (eastbound)\r\nCanyon Blvd & 11th St (#12663) (westbound)\r\nCanyon Blvd & 9th St (#12670) (westbound)\r\nCanyon Blvd & 6th St (#12668) (westbound)\r\nCanyon Blvd & 4th St (#12667) (westbound)\r\nCanyon Blvd & Pearl St (#18718) (westbound)\r\nCO 119 & Four Mile Canyon Rd (#18025) (westbound)\r\nCO 119 & Chapman Dr (#25782) (westbound)\r\nCO 119 & Magnolia Dr (#21921) (westbound)\r\nCO 119 & Mile Post 36 (#22936) (westbound)\r\nCO 119 & Mile Post 35 (#18027) (westbound)\r\nCO 119 & Boulder Falls (#21807) (westbound)\r\nCO 119 & Saint Anton (#21417) (westbound)\r\nCO 119 & Hurricane Hill Rd (#21922) (westbound)\r\nCO 119 & Stinky Gulch Rd (#21808) (westbound)\r\nBoulder Canyon Dr & E 3rd St (#18028) (westbound)\r\n\nFor eastbound NB2 get on/off buses at:\r\nNederland PnR (#21899)\r\nDowntown Boulder Station Gate 4 (#26102)\r\n\nFor westbound NB2 get on/off buses at:\r\nDowntown Boulder Station Gate 4 (#26102)\r\nNederland PnR (#21899)"
    language: "en"
  }
