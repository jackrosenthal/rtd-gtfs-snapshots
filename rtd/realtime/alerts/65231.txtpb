description_text {
  translation {
    text: "Affected southbound trips:\r\n6:15 am from 18th & Stout Station to Florida Station\r\n8:15 am from 18th & Stout Station to Florida Station\r\n10:15 am from 18th & Stout Station to Florida Station\r\n12:15 pm from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n7:24 am from Florida Station to 18th & California Station\r\n9:24 am from Florida Station to 18th & California Station\r\n11:24 am from Florida Station to 18th & California Station\r\n1:24 pm from Florida Station to 18th & California Station"
    language: "en"
  }
}
