description_text {
  translation {
    text: "Reroute to serve to Ralston Road/64th Avenue in Arvada west of the Independence and 58th intersection.\r\n\nReason\r\n\nRerouting the 52 maintains coverage to 64th/Ralston Road that would otherwise be lost due to the reroute of the route 72. Note: Western terminal located at W 63rd Ave. and Wright St. would not change."
    language: "en"
  }
}
