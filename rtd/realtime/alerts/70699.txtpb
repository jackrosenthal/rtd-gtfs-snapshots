cause: CONSTRUCTION
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "Change at Broadway Station from Tue Dec 2 at 10:00 PM to Wed Dec 3 at 4:00 AM due to construction."
    language: "en"
  }
}
description_text {
  translation {
    text: "Broadway between Ohio and Tennessee avenues will close Tuesday, Dec. 2, as early as 10 p.m. – lasting until Wednesday, Dec. 3, at 4 a.m. Construction crews will install an overhead sign bridge at Broadway & Kentucky Ave.\r\n\nOther closures during this time will include:\r\n-Westbound travel on Ohio Avenue to southbound Broadway (no southbound turns allowed).\r\n-Access to RTD’s I-25/Broadway Station at Kentucky Avenue.\r\n-Southbound I-25 on-ramp from northbound Broadway.\r\n-Southbound I-25 Broadway exit (207A) will be closed to right turns onto southbound Broadway.\r\n\n\r\nAreas remaining open:\r\n-Southbound I-25 Broadway exit (207A) will be able to make left turn onto Broadway, then continue onto northbound Lincoln.\r\n-Southbound I-25 on-ramp from southbound Broadway at Ohio.\r\n-Northbound I-25 on-ramp at Lincoln and Ohio.\r\n-Northbound I-25 off-ramp onto Broadway and Lincoln exit (207A)\r\n-Access to RTD’s I-25/Broadway Station at Exposition Avenue and Bannock Street."
    language: "en"
  }
}
