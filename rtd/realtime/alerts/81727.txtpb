  translation {
    text: "Affected northbound trips:\r\n12:52 pm from Littleton / Mineral Ave Station\r\n\nAffected southbound trips:\r\n1:34 pm from Union Station Track 12\r\n\nAffected stops:\r\nEnglewood Station\r\nEvans Station\r\nI-25 / Broadway Station\r\nAlameda Station\r\n10th / Osage Station\r\nAuraria West Campus Station\r\nEmpower Field at Mile High\r\nBall Arena / Elitch Gardens Station\r\nUnion Station"
