  translation {
    text: "Affected southbound trips:\r\n4:26 am from Evans Station\r\n\nAffected northbound trips:\r\n5:25 am from Ridgegate Parkway Station\r\n\nAffected stops:\r\nEvans Station\r\nRidgegate Parkway Station\r\nLone Tree City Center Station\r\nSky Ridge Station\r\nLincoln Station\r\nCounty Line Station\r\nDry Creek Station\r\nArapahoe at Village Center Station\r\nOrchard Station\r\nBelleview Station"
