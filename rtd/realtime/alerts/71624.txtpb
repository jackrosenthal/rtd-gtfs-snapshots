  translation {
    text: "Affected northbound trips:\r\n6:00 am from Evans Station\r\n7:34 am from I-25 & Broadway Station\r\n9:04 am from I-25 & Broadway Station\r\n10:34 am from I-25 & Broadway Station\r\n12:04 pm from I-25 & Broadway Station\r\n1:34 pm from I-25 & Broadway Station\r\n3:04 pm from I-25 & Broadway Station\r\n4:34 pm from I-25 & Broadway Station\r\n\nAffected southbound trips:\r\n6:46 am from 30th & Downing Station\r\n8:16 am from 30th & Downing Station\r\n9:46 am from 30th & Downing Station\r\n11:16 am from 30th & Downing Station\r\n12:46 pm from 30th & Downing Station\r\n2:16 pm from 30th & Downing Station\r\n3:46 pm from 30th & Downing Station\r\n5:16 pm from 30th & Downing Station"
