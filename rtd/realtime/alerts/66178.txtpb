header_text {
  translation {
    text: "Planned schedule change on L Line beginning Sun Aug 31."
    language: "en"
  }
}
description_text {
  translation {
    text: "L Line service suspended beginning August 31. Bus route 43 provides alternate service between 30th and Downing Station and the downtown corridor.\r\n \r\nThe next phase of light rail track reconstruction work in downtown Denver begins on September 2. This phase will involve reconstructing the light rail crossing on Kalamath Street between Colfax Ave and Speer Blvd. No light rail service will operate between 10th and Osage and 18th and California Stations, or between 30th and Downing and 16th and Stout Stations."
    language: "en"
  }
}
