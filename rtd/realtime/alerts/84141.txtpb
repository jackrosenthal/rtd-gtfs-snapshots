  translation {
    text: "Vehicle damaged crossing arms, trains in area will hold at stations until crossing is clear. \r\n\nAffected stops:\r\nFlorida Station\r\nAurora Metro Center Station\r\n2nd Ave & Abilene Station\r\n13th Ave Station\r\nColfax Station\r\nFitzsimons Station\r\nPeoria Station"
    language: "en"
  }
}
