header_text {
  translation {
    text: "Shuttle buses replacing A Line westbound on Sat Sep 12 until 3:00 PM due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD will conduct essential maintenance on the A Line on Saturday, Sept. 12, from approximately 3 a.m.-3 p.m. between Peoria and Denver Airport stations.\r\n\nBoard bus shuttles at the following locations:\r\nPeoria Station: Gate E\r\n40th Ave & Airport Blvd-Gateway Park: Gate A\r\n61st-Pena: In front of station\r\nDenver Airport Station: Arrivals at Gate 6; Departures at Gate 7"
    language: "en"
  }
}
severity_level: SEVERE
