cause: OTHER_CAUSE
effect: NO_SERVICE
header_text {
  translation {
    text: "S Line service suspended from 3:00 PM to 10:00 PM on Sat Dec 6 due to the Parade of Lights."
    language: "en"
  }
}
description_text {
  translation {
    text: "L Line service is suspended through Jan. 3, but RTD is operating a temporary Special Holiday Service (S Line) between I-25-Broadway and 30th-Downing stations. \r\n \r\nThe Holiday Train will not operate between the I-25-Broadway and Convention Center-Theatre District stations 3-10p.m. during the Parade of Lights event. "
    language: "en"
  }
}
