header_text {
  translation {
    text: "H Line service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nH Line will be suspended.\r\n\nReason\r\nFinal phases of the Downtown Rail Reconstruction Project will not allow for RTD to operate trains at Colfax at Auraria through the Downtown Loop. With the D Line rerouting to serve Union Station, there is not enough track capacity to reroute the H Line to Union Station. If approved, customers would transfer to/from E Line or T Line at Belleview Station for northbound service.\r\n\nSurvey Results\r\nOut of 147 respondents, 3% reported a positive impact from the change, 10% indicated it had no impact, and 87% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject\r\n"
    language: "en"
  }
}
