header_text {
  translation {
    text: "Route 52 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute 52 stop at 58th Avenue will be relocated to Ralston Road/64th Avenue. Western terminal located at 63rd Avenue and Wright Street will remain in place.\r\n\nReason\r\nRelocating the stop at 58th Avenue to Ralston Road/64th maintains coverage that would otherwise be lost due to the reroute of the Route 72.\r\n\nSurvey Results\r\nOut of 17 respondents, 41% reported a positive impact from the change, 29% indicated it had no impact, and 29% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
