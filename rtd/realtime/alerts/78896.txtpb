header_text {
  translation {
    text: "L Line service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nL Line will be suspended.\r\n\nReason\r\nFinal phases of the Downtown Rail Reconstruction Project will not allow for RTD to operate trains at Colfax at Auraria through the Downtown Loop. If approved, service on Bus Route 43 would be increased to support L Line customers.\r\n\nSurvey Results\r\nOut of 43 respondents, 2% reported a positive impact from the change, 33% indicated it had no impact, and 65% perceived the change negatively.\r\n\nAdditional information about the Downtown Rail Reconstruction Project can be found here: https://www.rtd-denver.com/railproject\r\n"
    language: "en"
  }
}
