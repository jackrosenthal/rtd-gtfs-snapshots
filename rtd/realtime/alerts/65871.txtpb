  }
}
description_text {
  translation {
    text: "Affected southbound trips:\r\n2:30 pm from 18th & Stout Station to Florida Station\r\n4:30 pm from 18th & Stout Station to Florida Station\r\n6:30 pm from 18th & Stout Station to Florida Station\r\n8:30 pm from 18th & Stout Station to Florida Station\r\n10:30 pm from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n3:39 pm from Florida Station to 18th & California Station\r\n5:39 pm from Florida Station to 18th & California Station\r\n7:39 pm from Florida Station to 18th & California Station\r\n9:39 pm from Florida Station to 18th & California Station"
    language: "en"
  }
}
