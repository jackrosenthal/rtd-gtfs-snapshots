description_text {
  translation {
    text: "Change\r\nRelocate the western terminal of Route 38 to Clear Creek Crossing Transfer Center in Wheat Ridge.\r\n\nReason\r\nMaintains service to Lutheran Hospital and provides operators access at the new transfer center.\r\n\nSurvey Results\r\nOut of 27 respondents, 52% reported a positive impact from the change, 44% indicated it had no impact, and 4% perceived the change negatively."
    language: "en"
  }
}
