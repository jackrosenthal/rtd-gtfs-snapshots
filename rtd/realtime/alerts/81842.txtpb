description_text {
  translation {
    text: "Affected stops:\r\nFederal Blvd & W 17th Ave (#13704) (northbound)\r\nFederal Blvd & W 20th Ave (#13706) (northbound)\r\nFederal Blvd & W 23rd Ave (#13709) (southbound)\r\nFederal Blvd & W 20th Ave (#13707) (southbound)\r\nFederal Blvd & W 17th Ave (#18820) (southbound)\r\n\nFor northbound Route 31 get on/off buses at:\r\nDecatur / Federal Station Gate E (#13703)\r\nFederal Blvd & W 23rd Ave (#13708)\r\n\nFor southbound Route 31 get on/off buses at:\r\nFederal Blvd & W 27th Ave (#13712)\r\nDecatur / Federal Station Gate F (#13702)"
    language: "en"
  }
}
