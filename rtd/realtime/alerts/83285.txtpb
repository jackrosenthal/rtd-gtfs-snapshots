header_text {
  translation {
    text: "Route 35 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nSeasonal tripper service will be reinstated, with an additional morning trip added to help alleviate overcrowding around John F. Kennedy High School’s bell times. Minor schedule adjustments will also be made.\r\n\nReason\r\nAlleviate overcrowding per school bell times at John F. Kennedy High School and improve operating conditions by providing additional recovery time for Operators.\r\n\nSurvey Results\r\nOut of 21 respondents, 48% reported a positive impact from the change, 29% indicated it had no impact, and 24% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
