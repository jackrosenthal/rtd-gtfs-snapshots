description_text {
  translation {
    text: "Change\r\nMinor schedule adjustment, shifting current 3:23 p.m. northbound trip to leave Fairview HS at 3:26 p.m.\r\n\nReason\r\nAdjust trip time to better align with Fairview High School dismissal time and allow additional boarding time for students.\r\n\nSurvey Results\r\nOut of 10 respondents, 70% reported a positive impact from the change, 20% indicated it had no impact, and 10% perceived the change negatively."
    language: "en"
  }
}
