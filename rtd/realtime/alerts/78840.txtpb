header_text {
  translation {
    text: "Route 10 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nChanges to service pattern to operate via 9th-Clermont every 20 minutes both eastbound and westbound between approximately 6:00 a.m. and 6:30 p.m. instead of the current 30-minute midday and 15-minute peak period peak direction service. Hourly trips to Aurora and Colfax & Billings will remain in place.\r\n\nReason\r\nChanges allow for an additional 11 new trips in support of the service expansion.\r\n\nSurvey Results\r\nOut of 36 respondents, 72% reported a positive impact from the change, 14% indicated it had no impact, and 14% perceived the change negatively."
    language: "en"
  }
}
