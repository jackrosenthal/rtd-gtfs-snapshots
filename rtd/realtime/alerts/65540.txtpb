  }
}
description_text {
  translation {
    text: "Affected eastbound trips:\r\n3:25 pm from Jeffco Government Center Station to Union Station Track 11\r\n5:25 pm from Jeffco Government Center Station to Union Station Track 11\r\n7:25 pm from Jeffco Government Center Station to Union Station Track 11\r\n9:25 pm from Jeffco Government Center Station to Union Station Track 11\r\n11:25 pm from Jeffco Government Center Station to Union Station Track 11\r\n\nAffected westbound trips:\r\n4:22 pm from Union Station Track 12 to Jeffco Government Center Station\r\n6:22 pm from Union Station Track 12 to Jeffco Government Center Station\r\n8:22 pm from Union Station Track 12 to Jeffco Government Center Station\r\n10:22 pm from Union Station Track 12 to Jeffco Government Center Station"
    language: "en"
  }
}
