header_text {
  translation {
    text: "D Line and H Line notice: on Sun Jan 4."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD expects an increase in ridership as the Broncos host the Los Angeles Chargers at 2:25 p.m., Sunday, Jan. 4, at Empower Field at Mile High. \r\n\r\nWith January service changes taking effect on Sunday, the D and H lines will return to their regular routing through downtown Denver. D and H line customers may reach Empower Field by exiting at Colfax at Auraria Station and walking to the stadium (approximately 20 minutes) or by transferring to the E Line at I-25•Broadway Station and riding to the Empower Field at Mile High Station"
    language: "en"
  }
}
