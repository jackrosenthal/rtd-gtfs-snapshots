description_text {
  translation {
    text: "Affected southbound trips:\r\n3:52 am from Evans Station to Florida Station\r\n5:30 am from 18th & Stout Station to Florida Station\r\n7:30 am from 18th & Stout Station to Florida Station\r\n9:30 am from 18th & Stout Station to Florida Station\r\n11:30 am from 18th & Stout Station to Florida Station\r\n\nAffected northbound trips:\r\n4:39 am from Florida Station to 18th & California Station\r\n6:39 am from Florida Station to 18th & California Station\r\n8:39 am from Florida Station to 18th & California Station\r\n10:39 am from Florida Station to 18th & California Station"
    language: "en"
  }
}
