cause: MAINTENANCE
effect: UNKNOWN_EFFECT
url {
  translation {
    text: "https://www.rtd-denver.com/community/news/2026/bus-shuttles-to-replace-portion-of-g-line-oct-24-25-during-track-bridge-maintenance"
    language: "en"
  }
}
header_text {
  translation {
    text: "G Line service change: from Sat Oct 24 at 9:00 PM to Sun Oct 25 at 3:00 AM due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "Bus shuttles will provide G Line rail service between the Wheat Ridge-Ward Road and Clear Creek-Federal stations for a six-hour period, from 9 p.m. on Saturday, Oct. 24, to 3 a.m. on Sunday, Oct. 25. The closure is necessary to support planned maintenance at the Balsam Street crossing and work by the City of Arvada on the Arvada Ralston bridge.  \r\n\nCustomers can board bus shuttles at the following station locations: \r\n•\tWheat Ridge-Ward Road – Gate B \r\n•\tArvada Ridge – Gate B \r\n•\tOlde Town Arvada – Gate A \r\n•\t60th & Sheridan-Arvada Gold Strike – Gate A \r\n•\tClear Creek-Federal – Gate C \r\n \r\n"
    language: "en"
  }
}
severity_level: WARNING
