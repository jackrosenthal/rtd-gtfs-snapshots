  agency_id: "RTD"
  route_id: "225"
  route_type: 3
}
cause: UNKNOWN_CAUSE
effect: UNKNOWN_EFFECT
header_text {
  translation {
    text: "Route 225 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nService pattern will adjust to terminate at Willoughby from 7:00 a.m. to 7:00 p.m. Before 7:00 a.m. and after 7:00 p.m., eastern terminal will remain at Lafayette Park-n-Ride. Reduction of service to summer seasonal levels.\r\n\nReason\r\nImproves on-time performance, aligns with seasonal ridership levels, and accommodates lack of operator respite access.\r\n\nSurvey Results\r\nOut of 13 respondents, 16% reported a positive impact from the change, 31% indicated it had no impact, and 53% perceived the change negatively."
    language: "en"
  }
}
