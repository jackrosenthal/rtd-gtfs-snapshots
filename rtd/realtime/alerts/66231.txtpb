  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n4:39 pm from Florida Station to 18th & California Station\r\n6:39 pm from Florida Station to 18th & California Station\r\n8:39 pm from Florida Station to 18th & California Station\r\n10:39 pm from Florida Station to 18th & California Station\r\n\nAffected southbound trips:\r\n5:30 pm from 18th & Stout Station to Florida Station\r\n7:30 pm from 18th & Stout Station to Florida Station\r\n9:30 pm from 18th & Stout Station to Florida Station\r\n11:30 pm from 18th & Stout Station to Florida Station\r\n\nAffected stops:\r\nFlorida Station\r\nIliff Station\r\nNine Mile Station\r\nDayton Station\r\nSouthmoor Station\r\nYale Station\r\nColorado Station\r\nUniversity of Denver Station\r\nLouisiana / Pearl Station\r\nI-25 / Broadway Station"
    language: "en"
  }
}
