  translation {
    text: "DASH service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nService will be reinstated to Willoughby Corner before 7 a.m. and after 7 p.m., with minor schedule adjustments and reinstatement of fall/winter service levels.\r\n\nReason\r\nImproves on-time performance, service reliability and operating conditions while supporting seasonal ridership levels.\r\n\nSurvey Results\r\nOut of 20 respondents, 75% reported a positive impact from the change, 25% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
