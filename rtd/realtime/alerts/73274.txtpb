header_text {
  translation {
    text: "DASH notice: beginning Mon Jan 26."
    language: "en"
  }
}
description_text {
  translation {
    text: "Buses will hold at Lafayette Park-n-Ride eastbound for an extended period, delays up to 10 minutes may be experienced. Westbound return trips will not have extended wait times. \r\n\nAffected stops:\r\nE Spaulding St & S Public Rd (#20012) (eastbound)\r\nE Spaulding St & Dove Cove (#22058) (eastbound)\r\nMerlin Dr & E Spaulding St (#35494) (eastbound)\r\nEmma St & 120th St (#35504) (eastbound)\r\nS 120th St & Canterbury Dr (#35496) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (eastbound)\r\nCanterbury Dr & Willoughby Blvd (#34847) (westbound)\r\nManhattan Cir & South Boulder Rd (#25972) (westbound)\r\nCanterbury Dr & Emma St (#35566) (westbound)\r\nMerlin Dr & E Spaulding St (#35495) (westbound)\r\nE Spaulding St & Dove St (#17909) (westbound)\r\nE Spaulding St & S Public Rd (#17910) (westbound)"
    language: "en"
  }
}
