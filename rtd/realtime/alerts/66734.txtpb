cause: MAINTENANCE
effect: OTHER_EFFECT
header_text {
  translation {
    text: "38th & Blake North Elevator unavailable until further notice every Monday, Tuesday, Wednesday, Thursday, Friday, Saturday and Sunday from 8:45 AM to end of service due to mechanical issue."
    language: "en"
  }
}
description_text {
  translation {
    text: "Elevator is out of service. Bus shuttles in place for passengers needing to get to the other side of the station."
    language: "en"
  }
}
