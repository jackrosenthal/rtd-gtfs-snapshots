header_text {
  translation {
    text: "AB1 and AB2 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nSchedules will be adjusted to align trips arriving at Table Mesa Park-n-Ride into a consistent 30-minute, clock-face pattern (:00 and :30), with trips departing 5 minutes after arrivals.\r\n\nReason\r\nCreate more consistent headways from Table Mesa PnR to Denver International Airport\r\n\nSurvey Results\r\nOut of 44 respondents, 81% reported a positive impact from the change, 16% indicated it had no impact, and 2% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
