header_text {
  translation {
    text: "Route 28 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute 28 will terminate all short-turn trips at the 30th•Downing Station instead of multiple locations during peak periods.\r\n\nReason\r\nSimplifies the route, making it more predictable and easier to understand for customers while maintaining service to key destinations like Central Park Station.\r\n\nSurvey Results\r\nOut of 16 respondents, 50% reported a positive impact from the change, 25% indicated it had no impact, and 25% perceived the change negatively."
    language: "en"
  }
}
