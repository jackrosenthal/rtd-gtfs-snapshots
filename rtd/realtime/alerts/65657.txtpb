description_text {
  translation {
    text: "Affected westbound trips:\r\n5:07 am from Union Station Track 12 to Jeffco Government Center Station\r\n7:07 am from Union Station Track 12 to Jeffco Government Center Station\r\n9:22 am from Union Station Track 12 to Federal Center Station\r\n10:52 am from Union Station Track 12 to Federal Center Station\r\n\nAffected eastbound trips:\r\n6:19 am from Jeffco Government Center Station to Union Station Track 11\r\n8:19 am from Jeffco Government Center Station to Union Station Track 11\r\n10:13 am from Federal Center Station to Union Station Track 11\r\n11:43 am from Federal Center Station to Union Station Track 11"
    language: "en"
  }
}
