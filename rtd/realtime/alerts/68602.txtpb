cause: OTHER_CAUSE
effect: NO_SERVICE
header_text {
  translation {
    text: "R Line southbound service suspended between Florida and Belleview Stations due to overhead wire repair. "
    language: "en"
  }
}
description_text {
  translation {
    text: "Board bus shuttles between Florida and Belleview Stations and transfer to E Line for service to/from Lincoln Station.\r\n\nAffected stops:\r\nFlorida Station (#34578)\r\nIliff Station (#34575)\r\nNine Mile Station (#34003)\r\nDayton Station (#34004)\r\nBelleview Station (#25991)\r\nOrchard Station (#25983)\r\nArapahoe at Village Center Station (#25990)\r\nDry Creek Station (#25989)\r\nCounty Line Station (#25988)\r\nLincoln Station (#25973)"
    language: "en"
  }
}
