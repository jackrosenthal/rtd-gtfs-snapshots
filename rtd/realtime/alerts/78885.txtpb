header_text {
  translation {
    text: "LD3 service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nIncrease service to every 30 minutes during morning and afternoon peak periods, between US 36 & Broomfield Station and Lafayette PnR, and renaming pf the route to Route 287 to clearly distinguish it from the regional LD1 service.\r\n\nReason\r\nImproves frequency and reliability for local/community riders between Longmont and US36 & Broomfield Station, and creates a distinct route number/identity that reflects its role as a local connector separate from the regional LD1 service.\r\n\nSurvey Results\r\nOut of 20 respondents, 75% reported a positive impact from the change, 15% indicated it had no impact, and 10% perceived the change negatively."
    language: "en"
  }
}
