header_text {
  translation {
    text: "Olde Town Arvada Transit Hub window replacement from 9:00 AM to 5:00 PM on Thu Oct 23."
    language: "en"
  }
}
description_text {
  translation {
    text: "A window at the Olde Town Transit Hub was damaged as a result of vandalism and needs to be replaced. The window is located on the 3rd floor elevator landing on the east side stairwell. Repairs will take place next Thursday, Oct. 23 9 a.m.-5 p.m. Pedestrian and bus access are expected to be maintained.\r\n\nThe parking garage at Olde Town Arvada is not owned or operated by RTD."
    language: "en"
  }
}
