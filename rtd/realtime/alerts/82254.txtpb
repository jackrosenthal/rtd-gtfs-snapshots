effect: NO_SERVICE
header_text {
  translation {
    text: "E Line Trip 4:10 pm from Ridgegate Parkway Station and 1 other trip cancelled today due to mechanical issue. Check trip status using NextRide, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected northbound trips:\r\n4:10 pm from Ridgegate Parkway Station\r\n\nAffected southbound trips:\r\n5:11 pm from Union Station Track 12\r\n\nAffected stops:\r\nAlameda Station\r\n10th / Osage Station\r\nAuraria West Campus Station\r\nEmpower Field at Mile High\r\nBall Arena / Elitch Gardens Station\r\nUnion Station"
    language: "en"
  }
}
