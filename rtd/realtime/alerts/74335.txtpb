cause: UNKNOWN_CAUSE
header_text {
  translation {
    text: "Route 225 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Adjust service pattern to terminate at Willoughby from 7:00 a.m. to 7:00 p.m. Before 7:00 a.m. and after 7:00 p.m., eastern terminal would remain at Lafayette Park-n-Ride. Reduce service to summer seasonal levels.\r\n\nReason: Improve on-time performance and accommodate lack of operator respite access.\r\n\n\r\nCustomer feedback on the Proposed June Service Changes will be collected through March 4. We invite you to virtually attend our public meetings and Ask a Service Planner session, or share your feedback through the online survey. Customer feedback is important to RTD, and we thank you for participating however you can!\r\n\nOnline feedback survey: https://rtddenver.qualtrics.com/jfe/form/SV_5vWH1ee1H4rliHs"
    language: "en"
  }
}
