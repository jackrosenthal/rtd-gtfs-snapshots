  translation {
    text: "Affected westbound trips:\r\n4:42 pm from Denver Airport Station\r\n5:12 pm from Denver Airport Station\r\n5:42 pm from Denver Airport Station\r\n6:12 pm from Denver Airport Station\r\n6:42 pm from Denver Airport Station\r\n\nAffected eastbound trips:\r\n4:45 pm from Union Station Track 1\r\n5:15 pm from Union Station Track 1\r\n5:45 pm from Union Station Track 1\r\n6:15 pm from Union Station Track 1"
    language: "en"
  }
}
