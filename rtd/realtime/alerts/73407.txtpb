header_text {
  translation {
    text: "Shuttle buses replacing A Line westbound from Sat Jan 31 through Sun Feb 1 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "A Line: RTD will provide bus shuttle service for A Line customers between Union Station and 38th-Blake Station.\r\n\n    A Line customers at Union Station can access the shuttle at Gate B22 in the underground bus concourse\r\n    A Line customers at 38th-Blake Station can access the shuttle at the bus bridge gate on Blake Street\r\n    A Line service will operate as normal between 38th-Blake Station and Denver Airport Station\r\n\nAffected stops:\r\n38th & Blake Station Track 2 (#34466)\r\nUnion Station Track 1 (#34667)"
    language: "en"
  }
}
