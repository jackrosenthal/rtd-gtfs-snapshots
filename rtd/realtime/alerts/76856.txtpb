  translation {
    text: "Affected eastbound trips:\r\n5:54 pm from Jeffco Government Center Station\r\n7:54 pm from Jeffco Government Center Station\r\n9:54 pm from Jeffco Government Center Station\r\n11:54 pm from Jeffco Government Center Station\r\n\nAffected westbound trips:\r\n6:53 pm from Union Station Track 12\r\n8:53 pm from Union Station Track 12\r\n10:53 pm from Union Station Track 12\r\n12:53 am from Union Station Track 12"
    language: "en"
  }
}
