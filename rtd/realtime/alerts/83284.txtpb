description_text {
  translation {
    text: "Change\r\nWestern terminal will be relocated from Old Town Arvada Station to Clear Creek Crossing Transfer Center in Wheat Ridge via 32nd Avenue.\r\n\nReason\r\nExtends access to Wheat Ridge and facilitates transfers to the 72 and 38 at Clear Creek Crossing Transfer Center.\r\n\nSurvey Results\r\nOut of 16 respondents, 82% reported a positive impact from the change, 13% indicated it had no impact, and 6% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
