  translation {
    text: "Affected direction: Southbound\r\n\nAffected stops:\r\nOgden St & 17th Ave (#15698)\r\nCorona St & Colfax Ave (#13187)\r\nCorona St & 12th Ave (#13180)\r\nCorona St & 11th Ave (#13179)\r\nCorona St & 9th Ave (#13186)\r\nCorona St & 8th Ave (#13185)\r\n\nAvailable alternate stops:\r\nDowning St & 18th Ave (#23074)\r\nCorona St & 6th Ave (#13184)"
    language: "en"
  }
}
