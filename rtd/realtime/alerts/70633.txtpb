header_text {
  translation {
    text: "E Line southbound service suspended due to accident."
    language: "en"
  }
}
description_text {
  translation {
    text: "E line service between Union Station and I-25 & Broadway Station has been suspended. Please board a D Line at Union Station to continue south. E Line Service from I-25 and Broadway Station to Southmoor Station operating every 45 minutes. E Line service between Southmoor Station and Ridgegate Station every 15 minutes. \r\n\n\r\nAffected stops:\r\nUnion Station Track 12 (#25434)\r\nBall Arena / Elitch Gardens Station (#25433)\r\nEmpower Field at Mile High Station (#25432)\r\nAuraria West Station (#25431)\r\n10th & Osage Station (#23059)\r\nAlameda Station (#23060)"
    language: "en"
  }
}
