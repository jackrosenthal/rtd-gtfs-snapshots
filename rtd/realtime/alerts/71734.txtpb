header_text {
  translation {
    text: "A Line Trip 11:15 am from Union Station Track 1 and 14 other trips cancelled today due to switch problem. Check trip status using Next Ride, https://rtdden.co/nr."
    language: "en"
  }
}
description_text {
  translation {
    text: "Affected direction: Eastbound\r\n\nAffected eastbound trips:\r\n11:15 am from Union Station Track 1\r\n11:45 am from Union Station Track 1\r\n12:15 pm from Union Station Track 1\r\n12:45 pm from Union Station Track 1\r\n1:15 pm from Union Station Track 1\r\n1:45 pm from Union Station Track 1\r\n2:15 pm from Union Station Track 1\r\n2:45 pm from Union Station Track 1\r\n3:15 pm from Union Station Track 1\r\n3:45 pm from Union Station Track 1\r\n4:15 pm from Union Station Track 1\r\n4:45 pm from Union Station Track 1\r\n5:15 pm from Union Station Track 1\r\n5:45 pm from Union Station Track 1\r\n6:15 pm from Union Station Track 1"
    language: "en"
  }
}
