header_text {
  translation {
    text: "Change at Decatur-Federal Station Park-n-Ride lot."
    language: "en"
  }
}
description_text {
  translation {
    text: "Effective September 1st, 2026, RTD is no longer affiliated with the Park-n-Ride lot at this station. Parking at this lot will be managed by Empower Field and associates, RTD parking policies will no longer be accepted. Alternative parking options are available at the Sheridan Station Garage or at the I-25 / Broadway Station.\r\n\nBus and light rail services continue to operate at the Decatur-Federal Station as scheduled. \r\n\nOptions to get to Broncos games can be found here: https://www.rtd-denver.com/community/news/2026/ride-rtd-to-the-broncos-regular-season-kickoff-this-sunday"
    language: "en"
  }
}
severity_level: WARNING
