header_text {
  translation {
    text: "Route 104L service change: beginning Sun Jun 7."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nAdjustment of westbound trip times to arrive 5 minutes earlier on weekends for better N Line connections; adding one eastbound trip (8:45 p.m.) and one westbound trip (9:50 p.m.) daily.\r\n\nReason\r\nImproves schedule balance and accommodates Denver Airport employee shift changes.\r\n\nSurvey Results\r\nOut of 18 respondents, 61% reported a positive impact from the change, 39% indicated it had no impact, and 0% perceived the change negatively."
    language: "en"
  }
}
