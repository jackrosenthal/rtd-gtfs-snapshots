description_text {
  translation {
    text: "Proposed Change\r\nReplace Saturday AB3 trips with AB2 trips, maintaining and increasing AB service along 28th Street in Boulder.\r\n\nReason\r\nReplacing Saturday AB3 trips with AB2 trips would provide additional transit access to Boulder Junction and give customers more options for parking and connecting to service, while maintaining existing AB service along 28th Street. The change would also help reduce bus overcrowding at Downtown Boulder Station."
    language: "en"
  }
}
