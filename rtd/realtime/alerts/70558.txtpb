header_text {
  translation {
    text: "E Line northbound service suspended due to traffic accident."
    language: "en"
  }
}
description_text {
  translation {
    text: "E line service north of Broadway Station has been suspended, please transfer to a D line train at Broadway Station for all stops north to Union Station. Transfer to Special Service trains for all stations north to 30th-Downing Station. \r\n\nAffected stops:\r\nI-25 & Broadway Station (#23041)\r\nAlameda Station (#23042)\r\n10th & Osage Station (#23043)\r\nAuraria West Station (#25427)\r\nEmpower Field at Mile High Station (#25428)\r\nBall Arena / Elitch Gardens Station (#25429)\r\nUnion Station Track 11 (#25430)"
    language: "en"
  }
}
