  translation {
    text: "Affected routes:\r\n28\r\n\nAffected stops:\r\n29th Ave & Fairfax St (#10749) (eastbound)\r\n29th Ave & Forest St (#10754) (eastbound)\r\n29th Ave & Hudson St (#10758) (eastbound)\r\n29th Ave & Ivanhoe St (#10764) (eastbound)\r\n29th Ave & Hudson St (#10759) (westbound)\r\n29th Ave & Forest St (#10755) (westbound)\r\n29th Ave & Elm St (#10748) (westbound)\r\n\nFor eastbound Route 28 get on/off buses at:\r\n29th Ave & Dexter St (#10747)\r\n29th Ave & Ivanhoe St (#10764)\r\n\nFor westbound Route 28 get on/off buses at:\r\n29th Ave & Ivanhoe St (#10765)\r\n29th Ave & Dahlia St (#10745)"
    language: "en"
  }
}
