    text: "Route 10 service change: beginning Sun Sep 27."
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nRoute 10 will be rerouted to Decatur•Federal Station as the western terminal via Auraria Pkwy., West Colfax Ave., and Federal Blvd.\r\n\nReason\r\nProvide bus connection from Downtown to Decatur/Federal to replace discontinued segment of Route 15L.\r\n\nSurvey Results\r\nOut of 27 respondents, 37% reported a positive impact from the change, 7% indicated it had no impact, and 56% perceived the change negatively."
    language: "en"
  }
}
severity_level: WARNING
