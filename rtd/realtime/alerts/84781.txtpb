header_text {
  translation {
    text: "AB1 Proposed Service Change:"
    language: "en"
  }
}
description_text {
  translation {
    text: "Change\r\nOn weekdays, provide two AB1 trips per hour serving Downtown Boulder Station for the majority of the day. On Saturdays and Sundays, provide hourly service for most of the day. Combined with AB2 service, these changes would provide 20-minute frequency at Table Mesa Station for most of the day on weekdays and 30-minute frequency on weekends.\r\n\nReason\r\nProvide more frequent service between Boulder and Denver International Airport to better align service with customer demand, subject to available space at DEN."
    language: "en"
  }
}
severity_level: WARNING
