  translation {
    text: "Affected westbound trips:\r\n10:12 am from Denver Airport Station\r\n10:42 am from Denver Airport Station\r\n11:12 am from Denver Airport Station\r\n11:42 am from Denver Airport Station\r\n12:12 pm from Denver Airport Station\r\n12:42 pm from Denver Airport Station\r\n1:12 pm from Denver Airport Station\r\n1:42 pm from Denver Airport Station\r\n2:12 pm from Denver Airport Station\r\n2:42 pm from Denver Airport Station\r\n\nAffected eastbound trips:\r\n10:15 am from Union Station Track 1\r\n10:45 am from Union Station Track 1\r\n11:15 am from Union Station Track 1\r\n11:45 am from Union Station Track 1\r\n12:15 pm from Union Station Track 1\r\n12:45 pm from Union Station Track 1\r\n1:15 pm from Union Station Track 1\r\n1:45 pm from Union Station Track 1\r\n2:15 pm from Union Station Track 1\r\n2:45 pm from Union Station Track 1"
    language: "en"
