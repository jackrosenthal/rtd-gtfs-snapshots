header_text {
  translation {
    text: "A Line service change: 30-minute frequency from Tue Sep 29 at 12:00 PM through Sat Oct 10 due to maintenance."
    language: "en"
  }
}
description_text {
  translation {
    text: "RTD will implement a temporary 30-minute service frequency on the A Line, seven days a week, to accommodate repairs by agency concessionaire operator Denver Transit Partners at the York/Josephine railroad crossing. The adjusted schedule begins with the noon departure from Denver Union Station on Tuesday, Sept. 29, and will remain in effect through Saturday, Oct. 10. \r\n\nBus shuttles will not be used during this extended service interruption to allow RTD customers to continue traveling between Union Station and Denver International Airport by rail, eliminating the need to alternate between rail and bus services. Trains will use a single track in some locations while construction at the York/Josephine crossing is underway."
    language: "en"
  }
}
severity_level: WARNING
