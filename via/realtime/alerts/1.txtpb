header_text {
  translation {
    text: "Hop CW & CCW Routes for weekend"
  }
}
description_text {
  translation {
    text: "CW At 16th and Broadway, turn left instead of right. Follow Broadway to Arapahoe. Turn Rt. Turn right onto Arapahoe and then turn left onto Folsom to complete the detour. CCW Instead of going up Folsom hill, turn right onto Arapahoe Ave. At 17th street turn left and follow 17th until it becomes University. Turn left onto Broadway and right onto 16th. Turn right onto Euclid. Then turn on 12th to College. A left onto College will complete the detour. We apologize for any inconvenience but because of circumstances, we had to divert off our normal route for the weekend."
  }
}
