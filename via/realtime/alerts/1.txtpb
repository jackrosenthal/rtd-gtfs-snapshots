    text: "Regent Parking Lot Closed Saturday"
  }
}
description_text {
  translation {
    text: "The parking lot on the south side of Regent Dr., just east of Broadway, will be used for football parking on Saturday. The Eldorado Springs Shuttle will instead serve New Vista High School, at 20th Baseline. The Shuttle will resume service to Regent Lot on Sunday."
